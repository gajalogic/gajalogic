---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const hardwareMetrics = [
  { value: '< ₹600', label: 'Soundbox BoM', sub: 'Sub-₹600 Bill of Materials at scale' },
  { value: 'FIPS 140-3', label: 'HSM Validation', sub: 'Thales Luna Network HSM integration' },
  { value: 'QRNG', label: 'True Entropy', sub: 'Silicon photonic quantum RNG feed' },
  { value: 'BLE', label: 'Offline Contactless', sub: 'Patent-pending beacon broadcasting' },
];

const hardwarePillars = [
  {
    eyebrow: 'EDGE DEVICE // ₹ ECONOMICS',
    title: 'OpenCPU Soundbox',
    desc: 'An architectural deep-dive into our OpenCPU 4G payment soundbox. By using Fibocom LE271-IN and LuatOS Air780E modules with FR4 PCB trace antennas, we achieve a sub-₹600 Bill of Materials — drastically reducing merchant deployment costs for UPI Acquiring networks.',
    href: `${base}/hardware/opencpu-soundbox`,
    linkLabel: 'Explore the BoM Breakthrough',
    iconPath: 'M11 5.882V19.24a1.76 1.76 0 01-3.177-.262l-1.6-3.532H5.5A2.5 2.5 0 013 12.95V11.05a2.5 2.5 0 012.5-2.5h.723l1.6-3.532A1.76 1.76 0 0111 5.882zm4.5 1.118a4.5 4.5 0 010 6',
  },
  {
    eyebrow: 'ROOT OF TRUST // HSM',
    title: 'Enterprise HSM',
    desc: 'Native integration with enterprise hardware: Thales Luna Network HSMs and Silicon Photonic Quantum Random Number Generators. Exact protocols for Security Officer Blue PED key activation and zeroization recovery — no black boxes.',
    href: `${base}/hardware/enterprise-hsm`,
    linkLabel: 'Explore the Root of Trust',
    iconPath: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  },
  {
    eyebrow: 'INNOVATION // CONTACTLESS',
    title: 'BLE Contactless',
    desc: 'Patent-pending offline payment broadcasting via Bluetooth Low Energy beacons and hardware secure elements — tailored specifically for future-proof NCMC and RuPay contactless acquiring.',
    href: `${base}/hardware/ble-contactless`,
    linkLabel: 'Explore Next-Gen Contactless',
    iconPath: 'M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.212 0',
  },
];
---

<Layout
  title="Hardware | GajaLogic Edge Devices & Root of Trust"
  description="Ultra-low-cost OpenCPU payment soundboxes, Thales Luna enterprise HSM integration with QRNG entropy, and patent-pending BLE contactless payment broadcasting."
>
  <PageHeader
    eyebrow="Hardware & Edge Security"
    title="Economics at the Edge, Trust at the Core"
    subtitle="For Operations Heads and Hardware Integrators: sub-₹600 merchant edge devices, enterprise root-of-trust hardware, and next-generation offline contactless rails."
    badge="Edge Devices // Enterprise HSM"
  >
    <div slot="actions">
      <a href="#pillars" class="btn-unibase-primary !py-2.5 !px-5 !text-sm">
        Explore Hardware Systems
      </a>
      <a href={`${base}/compliance`} class="btn-unibase-secondary !py-2.5 !px-5 !text-sm">
        Compliance & Trust Center
      </a>
    </div>
  </PageHeader>

  <!-- Metric Strip -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-16 relative z-10">
    <div class="unibase-card p-6 sm:p-8 shadow-sm">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 divide-y lg:divide-y-0 lg:divide-x divide-[#dadcdf]">
        {hardwareMetrics.map((m) => (
          <div class="pt-4 lg:pt-0 lg:px-4 text-center sm:text-left">
            <span class="text-xs font-mono uppercase tracking-wider text-[#3e61ff] block mb-1">{m.label}</span>
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-[#0f1419] tracking-tight">{m.value}</div>
            <p class="text-xs text-gray-500 mt-1">{m.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Three Hardware Pillars -->
  <section id="pillars" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider mb-2 inline-block">Hardware Deep Dives</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0f1419] tracking-tight mt-2">
        Three Hardware Programs
      </h2>
      <p class="text-gray-500 mt-3 text-base">
        Edge economics where payments happen. Sovereign trust where keys live.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {hardwarePillars.map((pillar) => (
        <div class="unibase-card p-8 flex flex-col justify-between relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#3e61ff]/0 group-hover:via-[#3e61ff]/40 to-transparent transition-all duration-500"></div>
          <div>
            <div class="p-3 w-fit rounded-xl bg-blue-50 border border-blue-200 text-[#3e61ff] mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={pillar.iconPath}/>
              </svg>
            </div>
            <span class="text-xs font-mono font-bold text-[#3e61ff] uppercase tracking-wider block mb-2">
              {pillar.eyebrow}
            </span>
            <h3 class="text-2xl font-extrabold text-[#0f1419] mb-3">
              {pillar.title}
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              {pillar.desc}
            </p>
          </div>
          <a
            href={pillar.href}
            class="inline-flex items-center text-sm font-bold text-[#3e61ff] group-hover:text-[#3151e6] group-hover:translate-x-1 transition-all"
          >
            <span>{pillar.linkLabel}</span>
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Design Philosophy -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[#dadcdf]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="unibase-card p-7">
        <span class="text-xs font-mono text-[#3e61ff] font-bold mb-3 block">01 //</span>
        <h4 class="text-lg font-bold text-[#0f1419] mb-2">Cost as an Architecture Constraint</h4>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
          Merchant device economics decide UPI Acquiring unit viability. BoM is engineered, not negotiated.
        </p>
      </div>
      <div class="unibase-card p-7">
        <span class="text-xs font-mono text-[#3e61ff] font-bold mb-3 block">02 //</span>
        <h4 class="text-lg font-bold text-[#0f1419] mb-2">PQC-Ready Secure Elements</h4>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
          Every shipped device carries a hardware secure element sized for lattice cryptography, not just today's curves.
        </p>
      </div>
      <div class="unibase-card p-7">
        <span class="text-xs font-mono text-[#3e61ff] font-bold mb-3 block">03 //</span>
        <h4 class="text-lg font-bold text-[#0f1419] mb-2">Protocol Transparency</h4>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
          Key ceremonies, PED activation, and zeroization are documented protocols — auditable, repeatable, black-box free.
        </p>
      </div>
    </div>
  </section>

  <CtaBanner
    title="Deploy Edge Devices Without Destroying Unit Economics"
    subtitle="Request the full soundbox BoM teardown, HSM integration runbook, or a BLE contactless pilot kit for your acquiring network."
    buttonText="Talk to Hardware Engineering"
    buttonHref={`${base}/company/contact`}
    secondaryText="View the Platform Stack"
    secondaryHref={`${base}/platform`}
  />
</Layout>
