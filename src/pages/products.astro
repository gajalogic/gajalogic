---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const products = [
  {
    id: 'accelerators',
    name: 'GajaLogic G4-Titan',
    badge: 'Flagship Accelerator',
    tagline: 'PCIe 5.0 Ultra-Dense Tensor Engine',
    desc: 'Engineered for dense LLM inference, real-time embeddings, and scientific simulations with 380 TFLOPS dense FP8 throughput per half-length PCIe card.',
    specs: [
      { label: 'Compute', value: '380 TFLOPS FP8 / 190 TFLOPS FP16' },
      { label: 'Memory', value: '96 GB HBM3e @ 3.2 TB/s' },
      { label: 'Interconnect', value: 'LogicLink 128 GB/s mesh' },
      { label: 'Thermal Profile', value: '75W TDP (Passive/Active options)' },
    ],
    features: [
      'Hardware-isolated cryptographic enclave with FIPS 140-3 L4 root-of-trust',
      'Zero-wait DMA direct peer-to-peer fabric bypasses CPU overhead',
      'Hardware native FP8, INT4, and FP4 quantization kernels',
    ],
  },
  {
    id: 'edge',
    name: 'Gaja-Edge Micro V2',
    badge: 'Industrial Edge Appliance',
    tagline: 'Ruggedized Sovereign AI Compute',
    desc: 'Compact, fanless field unit for autonomous defense, robotics, SCADA systems, and edge telemetry operating under -40°C to +85°C environments.',
    specs: [
      { label: 'Compute', value: '64 TFLOPS INT8 / 32 TFLOPS FP16' },
      { label: 'Memory', value: '32 GB LPDDR5X ECC Unified' },
      { label: 'I/O Connectivity', value: 'Dual 10GbE + CAN-FD + PCIe 4.0' },
      { label: 'Power Consumption', value: '18W - 35W dynamic scaling' },
    ],
    features: [
      'MIL-STD-810H shock, vibration, and thermal resilience',
      'Physical tamper detection with automated cryptographic key zeroization',
      'Instant-on cold-boot in < 320 milliseconds',
    ],
  },
  {
    id: 'os',
    name: 'Logic-OS Enterprise Runtime',
    badge: 'Cluster Management OS',
    tagline: 'Bare-Metal Distributed Orchestration',
    desc: 'Deterministic operating system kernel purpose-built for AI clusters. Eliminates noisy-neighbor jitter and scales from a single blade to 10,000+ nodes.',
    specs: [
      { label: 'Scheduling Jitter', value: '< 2.5 microseconds deterministic' },
      { label: 'Failover Recovery', value: 'Zero-loss state checkpointing' },
      { label: 'Model Partitioning', value: 'Automated 3D tensor & pipeline sharding' },
      { label: 'Compliance Level', value: 'Common Criteria EAL4+ Ready' },
    ],
    features: [
      'Kernel-bypass network drivers for InfiniBand, RoCE v2, and LogicLink',
      'Air-gapped telemetry recorder with immutable cryptographic logs',
      'Native Kubernetes CSI and device-plugin integration',
    ],
  },
  {
    id: 'cloud-bridge',
    name: 'GajaLogic Cloud Bridge',
    badge: 'Hybrid Cloud Gateway',
    tagline: 'Secure Sovereign Inference Gateway',
    desc: 'Unifies private on-premise hardware clusters with public cloud VPCs via hardware-authenticated encrypted overlays and intelligent traffic routing.',
    specs: [
      { label: 'Throughput', value: '400 Gbps line-rate wire encryption' },
      { label: 'Encryption Standard', value: 'AES-256-GCM + Post-Quantum Kyber-1024' },
      { label: 'Latency Overhead', value: '< 15 microseconds per packet' },
      { label: 'Multi-Tenant Isolation', value: 'Cryptographic tenant namespaces' },
    ],
    features: [
      'Eliminates vendor lock-in across AWS, Azure, GCP, and private bare-metal',
      'Automatic cost & latency policy-based dispatch router',
      'Integrated real-time auditing and compliance policy enforcer',
    ],
  },
];

const comparisonSpecs = [
  { spec: 'Architecture', titan: 'LogicCore V4 Tensor', edge: 'LogicCore Nano', os: 'Microkernel 64-bit', cloud: 'Multi-Protocol Envoy' },
  { spec: 'Peak Compute', titan: '380 TFLOPS (FP8)', edge: '64 TFLOPS (INT8)', os: 'Scales to 10k nodes', cloud: 'Line-Rate 400 Gbps' },
  { spec: 'Memory Architecture', titan: '96 GB HBM3e', edge: '32 GB LPDDR5X ECC', os: 'Shared Memory Fabric', cloud: 'Zero-Copy Ring Buffer' },
  { spec: 'Power Envelope', titan: '75W TDP', edge: '18W - 35W', os: 'Low Host Overhead', cloud: 'Appliance / VM' },
  { spec: 'Security Level', titan: 'FIPS 140-3 L4 Enclave', edge: 'MIL-STD-810H + Tamper', os: 'EAL4+ Deterministic', cloud: 'Post-Quantum Kyber' },
];
---

<Layout
  title="Products | GajaLogic Compute Accelerators & Appliances"
  description="Explore GajaLogic flagship hardware accelerators, edge appliances, cluster operating systems, and sovereign cloud gateways."
>
  <PageHeader
    eyebrow="Portfolio & Systems"
    title="High-Yield Compute Products"
    subtitle="From single-board ruggedized edge nodes to exascale cluster blades, explore the complete GajaLogic hardware and software line."
    badge="Production Hardware"
  >
    <div slot="actions">
      <a
        href="#specs"
        class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-slate-800 text-slate-200 hover:text-white hover:bg-slate-700 border border-slate-700 transition-colors"
      >
        View Spec Comparison
      </a>
      <a
        href={`${base}/company#contact`}
        class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-sky-400 text-slate-950 hover:bg-sky-300 shadow-sm transition-colors"
      >
        Request Dev Evaluation Unit
      </a>
    </div>
  </PageHeader>

  <!-- Product Showcase Cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 space-y-16">
    {products.map((p, idx) => (
      <div id={p.id} class="glass-panel rounded-3xl p-8 sm:p-12 border border-white/10 relative overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Product Description -->
          <div class="lg:col-span-7 space-y-6">
            <div class="flex flex-wrap items-center gap-3">
              <span class="text-xs font-mono font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20">
                {p.badge}
              </span>
              <span class="text-xs text-slate-400 font-mono">{p.tagline}</span>
            </div>

            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
              {p.name}
            </h2>

            <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
              {p.desc}
            </p>

            <div class="space-y-3 pt-2">
              <h4 class="text-xs font-mono font-semibold uppercase text-slate-400 tracking-wider">Key Architectural Capabilities</h4>
              <ul class="space-y-2">
                {p.features.map((f) => (
                  <li class="flex items-start text-sm text-slate-300">
                    <svg class="w-5 h-5 text-sky-400 mr-2.5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 flex flex-wrap gap-4">
              <a
                href={`${base}/hardware`}
                class="inline-flex items-center text-sm font-semibold text-sky-400 hover:text-sky-300"
              >
                Detailed Silicon Specs
                <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
              <span class="text-slate-600">|</span>
              <a
                href={`${base}/company#contact`}
                class="inline-flex items-center text-sm font-semibold text-slate-300 hover:text-white"
              >
                Order Evaluation Kit
              </a>
            </div>
          </div>

          <!-- Product Specs Sidebar Card -->
          <div class="lg:col-span-5 bg-slate-900/90 rounded-2xl p-6 border border-slate-800 space-y-4">
            <h3 class="text-sm font-mono uppercase text-sky-400 font-semibold tracking-wider flex items-center justify-between">
              <span>Hardware Telemetry</span>
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            </h3>
            <div class="divide-y divide-slate-800">
              {p.specs.map((s) => (
                <div class="py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                  <span class="text-xs text-slate-400 font-mono">{s.label}</span>
                  <span class="text-sm text-white font-medium font-mono">{s.value}</span>
                </div>
              ))}
            </div>
            <div class="pt-2">
              <div class="p-3 bg-slate-950 rounded-xl border border-slate-800/80 text-xs font-mono text-slate-400 flex items-center justify-between">
                <span>Production Status:</span>
                <span class="text-emerald-400 font-semibold">In Stock & Shipping</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    ))}
  </section>

  <!-- Technical Spec Comparison Table -->
  <section id="specs" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 border-t border-white/5">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-mono uppercase tracking-widest text-sky-400 mb-2">Technical Matrix</h2>
      <h3 class="text-3xl font-extrabold text-white tracking-tight">System Specification Comparison</h3>
    </div>

    <div class="overflow-x-auto glass-panel rounded-2xl border border-white/10">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="bg-slate-900/90 text-xs font-mono uppercase text-slate-400 border-b border-slate-800">
          <tr>
            <th class="px-6 py-4">Specification</th>
            <th class="px-6 py-4 text-sky-400">G4-Titan</th>
            <th class="px-6 py-4 text-white">Edge Micro V2</th>
            <th class="px-6 py-4 text-indigo-400">Logic-OS</th>
            <th class="px-6 py-4 text-purple-400">Cloud Bridge</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800 font-mono text-xs sm:text-sm">
          {comparisonSpecs.map((row) => (
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="px-6 py-4 font-semibold text-slate-200">{row.spec}</td>
              <td class="px-6 py-4 text-sky-300">{row.titan}</td>
              <td class="px-6 py-4">{row.edge}</td>
              <td class="px-6 py-4 text-indigo-300">{row.os}</td>
              <td class="px-6 py-4 text-purple-300">{row.cloud}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <CtaBanner
    title="Need Custom Form Factors or Silicon Packaging?"
    subtitle="Our OEM & defense engineering team designs custom carrier boards, thermal heatsinks, and mezzanine cards."
    buttonText="Talk to Hardware Engineering"
  />
</Layout>
