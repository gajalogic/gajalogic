---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const transitMetrics = [
  { value: '< 240 ms', label: 'Turnstile Tap SLA', sub: 'Target < 300ms strict commuter gate barrier' },
  { value: 'Zero Leakage', label: 'Offline Wallet Balance Guarantee', sub: 'Cryptographically bounded stored value' },
  { value: '< 48 KB', label: 'PQC Smart Card Footprint', sub: 'Optimized lattice keys for low-memory silicon' },
  { value: '100% Interoperable', label: 'One Nation One Card (NCMC)', sub: 'Metros, buses, parking & tolls' },
];

const transitArchitectureModules = [
  {
    step: 'Module 01 // Sub-300ms Mass Transit Transactions (MTT)',
    title: 'Deterministic Turnstile Tap Execution',
    desc: 'Commuter turnstiles in Delhi, Mumbai, Bengaluru, and Chennai metros experience 1,200+ passenger taps per gate per hour. Gajalogic executes offline cryptographic certificate authentication, balance debit, and gate relay actuation in under 240 milliseconds, completely preventing commuter bottleneck queues.',
    tech: ['Offline Tap Verification', 'qSPARC 2.0 Specification', 'Hardware Relay Actuation'],
  },
  {
    step: 'Module 02 // Dual-Mode Offline Stored Value Ledger',
    title: 'Zero-Leakage Offline Wallet Reconciliation',
    desc: 'Buses and underground metro stations frequently lose 4G/5G and wired network connectivity. Our offline stored value ledger synchronizes batch transaction journals to central host clearing nodes upon reconnect with zero financial leakage and cryptographic non-repudiation.',
    tech: ['Offline Stored Value (SV)', 'Cryptographic Rollback Prevention', 'Asynchronous Host Sync'],
  },
  {
    step: 'Module 03 // PQC-Ready Smart Card Silicon R&D',
    title: 'Post-Quantum Defense on Constrained Silicon',
    desc: 'Smart card microcontrollers have severe constraints: typically < 64 KB of EEPROM and 8 KB of RAM. Standard PQC signatures (Dilithium / Falcon) exceed these buffers. Gajalogic leads R&D into stateful hash-based signatures and memory-optimized ML-KEM profiles engineered specifically for physical transit smart cards.',
    tech: ['Compact Lattice Key Compression', 'Sub-48KB Smart Card Profile', 'NIST PQC Microcontroller Ready'],
  },
  {
    step: 'Module 04 // Central Automated Transit Clearing House',
    title: 'Multi-Modal Fare Settlement Engine',
    desc: 'Aggregates commuter taps across metro lines, feeder bus networks, and automated toll plazas. Automatically executes fare rules, peak/off-peak discounts, and daily multi-operator settlement with participating transit acquirer banks.',
    tech: ['Dynamic Distance Fare Matrix', 'Multi-Operator Revenue Split', 'NPCI NCMC Host Clearing'],
  },
];

const transitComparison = [
  {
    dimension: 'Turnstile Gate Latency SLA',
    legacy: 'Legacy RFID/NCMC readers average 380ms - 520ms, exceeding the 300ms passenger gate limit and causing commuter queue stalls during morning rush.',
    gajalogic: 'Deterministic in-gate processing completes in < 240ms, enabling seamless pedestrian throughput of 45+ passengers per gate per minute.',
  },
  {
    dimension: 'Offline Financial Leakage Defense',
    legacy: 'Basic counter increments vulnerable to replay attacks and balance desynchronization when readers operate offline for prolonged intervals.',
    gajalogic: 'Cryptographically bounded state-machine journals with monotonic hardware counters, completely preventing replay and double-tap fraud.',
  },
  {
    dimension: 'Post-Quantum Cryptographic Readiness',
    legacy: 'Stuck on obsolete DESfire EV1 / Mifare / RSA-1024 chips that can be cloned using commodity software and future quantum techniques.',
    gajalogic: 'PQC-ready dual-interface architecture supporting hybrid classical/post-quantum authentication tailored for constrained transit smart cards.',
  },
  {
    dimension: 'Multi-Modal Mobility Integration',
    legacy: 'Siloed closed-loop ticketing systems requiring separate smart cards for metro, buses, and smart parking facilities.',
    gajalogic: 'Unified One Nation One Card (NCMC) architecture interoperable across all national transit networks, EV chargers, and municipal toll booths.',
  },
];
---

<Layout
  title="NCMC & Transit Solutions | Gajalogic Mass Transit Rail"
  description="Sub-300ms Mass Transit Transactions (MTT), offline wallet balance ledgers, and PQC-ready smart card architectures for Transit Authorities and Smart Cities."
>
  <PageHeader
    eyebrow="Mass Transit Infrastructure // NCMC Rail"
    title="NCMC & Transit Solutions"
    subtitle="Engineered for Transit Authorities, Metro Rail Corporations, and Smart Mobility Leads. Process high-velocity commuter taps in under 240ms with zero-leakage offline wallet ledgers and memory-optimized post-quantum smart card profiles."
    badge="Transit Switch v4.2"
  >
    <div slot="actions">
      <a
        href="#architecture"
        class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-amber-400 text-slate-950 hover:bg-amber-300 shadow-sm transition-all"
      >
        Explore Transit Architecture
      </a>
      <a
        href="#pqc-rd"
        class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-slate-900 text-slate-200 hover:text-white border border-slate-700 transition-colors"
      >
        PQC Smart Card Silicon R&D
      </a>
    </div>
  </PageHeader>

  <!-- High-Contrast Metric Telemetry Strip -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-16 relative z-10">
    <div class="unibase-card p-6 sm:p-8 border border-white/10 bg-slate-950/90 shadow-2xl">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 divide-y lg:divide-y-0 lg:divide-x divide-slate-800">
        {transitMetrics.map((m) => (
          <div class="pt-4 lg:pt-0 lg:px-4 text-center sm:text-left">
            <span class="text-xs font-mono uppercase tracking-wider text-amber-400 block mb-1">{m.label}</span>
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-white tracking-tight">{m.value}</div>
            <p class="text-xs text-slate-400 mt-1">{m.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Architecture Modules -->
  <section id="architecture" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider text-amber-400 border-amber-500/30 bg-amber-950/30 mb-2 inline-block">
        Mass Transit Architecture
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-2">
        Sub-300ms Turnstiles & Zero-Leakage Offline Wallets
      </h2>
      <p class="text-slate-400 mt-3 text-base">
        Eliminate passenger bottlenecks at metro turnstiles and bus gates with deterministic offline cryptographic execution.
      </p>
    </div>

    <!-- 4 Modules Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {transitArchitectureModules.map((mod) => (
        <div class="unibase-card p-8 flex flex-col justify-between border border-white/10 relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-amber-500/0 group-hover:via-amber-400/60 to-transparent transition-all duration-500"></div>
          <div>
            <span class="text-xs font-mono font-semibold text-amber-400 uppercase tracking-wider block mb-2">
              {mod.step}
            </span>
            <h3 class="text-2xl font-bold text-white mb-3">
              {mod.title}
            </h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-6 font-light">
              {mod.desc}
            </p>
          </div>
          <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-800">
            {mod.tech.map((t) => (
              <span class="mono-tag text-[11px] bg-slate-900 text-slate-300 border-slate-800">
                {t}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- PQC Smart Card R&D Section -->
  <section id="pqc-rd" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5">
    <div class="unibase-card p-8 sm:p-12 border border-white/10 bg-slate-950/80">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <span class="mono-tag font-semibold uppercase text-amber-400 border-amber-500/30 bg-amber-950/30">
            Silicon R&D // Post-Quantum Smart Card Cryptography
          </span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            PQC Architecture for Memory-Constrained Silicon
          </h3>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-light">
            While server-class cloud environments can easily process multi-kilobyte post-quantum keys, physical transit cards (contactless dual-interface JavaCard/NATIVE smart chips) possess severe execution bounds: typically 32 KB to 64 KB of persistent EEPROM and ultra-low clock speeds.
          </p>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-light">
            Gajalogic's silicon cryptography R&D team has engineered a compact <strong class="text-white font-medium">hybrid stateful hash / compressed lattice verification engine</strong> that fits inside an unprecedented <strong class="text-amber-400 font-mono">48 KB card footprint</strong>. Turnstiles verify authenticity in under 80 milliseconds of NFC RF field contact, ensuring sovereign transit infrastructure remains secure against future quantum cloning devices.
          </p>
          <div class="pt-2 flex flex-wrap gap-4 text-xs font-mono text-slate-400">
            <span class="flex items-center gap-1.5 text-amber-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Compatible with RuPay qSPARC Contactless Specs
            </span>
            <span class="flex items-center gap-1.5 text-sky-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              ISO 14443 Type A/B 13.56 MHz High-Speed RF Communication
            </span>
          </div>
        </div>

        <div class="lg:col-span-5 bg-slate-900/90 rounded-2xl p-6 border border-slate-800 font-mono text-xs text-slate-300 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-slate-800 text-slate-400">
            <span>TURNSTILE_NFC_TELEMETRY</span>
            <span class="text-emerald-400">GATE OPEN</span>
          </div>
          <div><span class="text-amber-400">gate_id:</span> <span class="text-slate-100">"DELHI-METRO-NDLS-G04"</span></div>
          <div><span class="text-amber-400">card_applet_profile:</span> <span class="text-slate-100">"NCMC_qSPARC_PQC_V2"</span></div>
          <div><span class="text-amber-400">rf_contact_time:</span> <span class="text-sky-300 font-bold">142 ms</span></div>
          <div><span class="text-amber-400">offline_balance_before:</span> <span class="text-slate-100">INR 480.00</span></div>
          <div><span class="text-amber-400">fare_deducted:</span> <span class="text-slate-100">INR 32.00</span></div>
          <div><span class="text-amber-400">crypto_verification_time:</span> <span class="text-emerald-400 font-bold">78 ms (Target &lt; 120ms)</span></div>
          <div><span class="text-amber-400">total_turnstile_latency:</span> <span class="text-emerald-400 font-bold">220 ms (PASSED SLA &lt; 300ms)</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Legacy Transit vs. Gajalogic Comparison Table -->
  <section id="comparison" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400 mb-2">Transit Benchmark Matrix</h2>
      <h3 class="text-3xl font-extrabold text-white tracking-tight">
        Legacy Transit Ticketing Systems vs. Gajalogic NCMC Rail
      </h3>
      <p class="text-slate-400 mt-2 text-sm sm:text-base">
        A comparative evaluation for Metro Rail Authorities, Smart City Transport Departments, and Mobility Operators.
      </p>
    </div>

    <div class="unibase-card overflow-hidden border border-white/10 shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900/90 text-xs font-mono uppercase text-slate-400 border-b border-slate-800">
            <tr>
              <th class="px-6 py-4 w-1/4">Evaluation Parameter</th>
              <th class="px-6 py-4 w-3/8 text-rose-400">Legacy Closed-Loop / Early NCMC Systems</th>
              <th class="px-6 py-4 w-3/8 text-amber-400 font-bold">Gajalogic High-Velocity NCMC Rail</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-xs sm:text-sm">
            {transitComparison.map((row) => (
              <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="px-6 py-4 font-mono font-semibold text-white bg-slate-950/40">
                  {row.dimension}
                </td>
                <td class="px-6 py-4 text-slate-400 leading-relaxed border-r border-slate-800">
                  {row.legacy}
                </td>
                <td class="px-6 py-4 text-slate-200 leading-relaxed bg-amber-950/10">
                  {row.gajalogic}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Executive CTA -->
  <CtaBanner
    title="Modernize Your Metro & City Transit Gates with Gajalogic NCMC"
    subtitle="Connect with our smart transit systems engineers for turnstile benchmark simulations, hardware card profiling, and pilot deployments."
    buttonText="Schedule Transit Engineering Briefing"
    secondaryText="Explore NPCI Product Suite"
    secondaryHref={`${base}/products`}
  />
</Layout>
