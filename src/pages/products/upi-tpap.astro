---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tpapMetrics = [
  { value: '< 180 KB', label: 'Client SDK Footprint', sub: 'Zero crypto bloat on iOS & Android' },
  { value: '12 Sponsor Banks', label: 'Simultaneous Multi-PSP Mesh', sub: 'Dynamic AI-driven health routing' },
  { value: '99.999%', label: 'Session Continuity SLA', sub: 'Sub-second in-flight PSP failover' },
  { value: 'Zero-Code', label: 'NPCI Circular Updates', sub: 'Instant remote policy push' },
];

const tpapPillars = [
  {
    step: 'Pillar 01 // Decoupled Cryptographic Sidecar',
    title: 'Isolate PQC Complexity from Mobile Clients',
    desc: 'Post-quantum key encapsulation (ML-KEM) and signatures (ML-DSA) require non-trivial key sizes (up to 1,568 bytes) and cryptographic compute. Gajalogic decouples PQC key management into high-speed gateway sidecars, keeping consumer mobile app APK/IPA sizes featherlight.',
    tech: ['Stateless Token Exchange', 'Sidecar PQC Key Broker', 'NIST FIPS 203 Handshake'],
  },
  {
    step: 'Pillar 02 // Multi-Bank PSP Traffic Mesh',
    title: 'Eliminate Sponsor Bank Outage Blackouts',
    desc: 'When a partner sponsor bank suffers a connectivity dip or degradation, Gajalogic dynamically shifts traffic across secondary and tertiary PSPs in real-time without session teardown or consumer app error prompts.',
    tech: ['Autonomous PSP Health Probes', 'Predictive Route Hedging', 'Sub-Second Traffic Shedding'],
  },
  {
    step: 'Pillar 03 // Real-Time Regulatory Policy Push',
    title: 'Instant Compliance without Mobile App Updates',
    desc: 'NPCI regularly introduces circulars regarding handle migrations, interchange mandates, and payment limits. Gajalogic allows TPAP product teams to update routing policies and regulatory flags dynamically from the cloud without shipping app store updates.',
    tech: ['Dynamic Policy Engine', 'Instant Over-The-Air Config', 'Automated Circular Audit'],
  },
  {
    step: 'Pillar 04 // High-Concurrency Intent Routing',
    title: 'Sub-Millisecond Deep-Link & Intent Handling',
    desc: 'Purpose-built to ingest millions of concurrent UPI Intent calls generated by e-commerce checkout flows, ridesharing apps, and food delivery platforms with low CPU memory overhead and zero queue stalls.',
    tech: ['Zero-Copy Intent Ingestion', 'Lock-Free Token Bucket', 'High-Yield Redis Cluster Fabric'],
  },
];

const tpapComparison = [
  {
    dimension: 'Mobile Client Impact',
    traditional: 'Heavyweight vendor SDKs (18MB+) bundling deprecated OpenSSL libraries, proprietary HSM bridges, and security vulnerabilities.',
    gajalogic: 'Ultralight headless SDK (< 180 KB). Zero cryptographic binary bloat; all PQC operations offloaded to sovereign edge sidecars.',
  },
  {
    dimension: 'Sponsor Bank Failure Handling',
    traditional: 'Static routing tables. If the primary sponsor bank goes down, all customer transactions fail until manual config changes occur.',
    gajalogic: 'Dynamic autonomous multi-PSP mesh. Evaluates real-time bank health every 50ms and redirects intent sessions seamlessly.',
  },
  {
    dimension: 'Regulatory Compliance Speed',
    traditional: 'Requires modifying client-side code, testing across hundreds of Android device models, and waiting 5-10 days for App Store review.',
    gajalogic: '100% server-driven compliance orchestrator. Update merchant limits, handle schemes, and dispute workflows in seconds.',
  },
  {
    dimension: 'Post-Quantum Future Proofing',
    traditional: 'Non-existent. Any future quantum migration requires redistributing and reinstalling client-side device certificates.',
    gajalogic: 'Native PQC isolation layer. Transparently upgrades from classical to hybrid quantum-safe handshakes with zero app changes.',
  },
];
---

<Layout
  title="UPI TPAP Infrastructure | Gajalogic Sovereign Fintech Engine"
  description="Scalable multi-bank API infrastructure for Third-Party Application Providers with decoupled post-quantum key management and ultralight mobile SDKs."
>
  <PageHeader
    eyebrow="Fintech Scale Engine // TPAP Infrastructure"
    title="High-Scale TPAP Infrastructure"
    subtitle="Engineered for Consumer Fintech Architects and Integration Leads. Run multi-bank UPI consumer apps at massive scale with decoupled post-quantum security, sub-millisecond intent routing, and zero mobile app bloat."
    badge="TPAP Engine v4.3"
  >
    <div slot="actions">
      <a
        href="#architecture"
        class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-sky-400 text-slate-950 hover:bg-sky-300 shadow-sm transition-all"
      >
        Inspect Decoupled PQC Architecture
      </a>
      <a
        href="#comparison"
        class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-slate-900 text-slate-200 hover:text-white border border-slate-700 transition-colors"
      >
        SDK & TCO Matrix
      </a>
    </div>
  </PageHeader>

  <!-- High-Contrast Metric Telemetry Strip -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-16 relative z-10">
    <div class="unibase-card p-6 sm:p-8 border border-white/10 bg-slate-950/90 shadow-2xl">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 divide-y lg:divide-y-0 lg:divide-x divide-slate-800">
        {tpapMetrics.map((m) => (
          <div class="pt-4 lg:pt-0 lg:px-4 text-center sm:text-left">
            <span class="text-xs font-mono uppercase tracking-wider text-purple-400 block mb-1">{m.label}</span>
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-white tracking-tight">{m.value}</div>
            <p class="text-xs text-slate-400 mt-1">{m.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Architectural Deep-Dive: Decoupled PQC & Multi-PSP -->
  <section id="architecture" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider mb-2 inline-block">Architecture Blueprint</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-2">
        Decoupled Cryptographic Gateways & Autonomous Routing
      </h2>
      <p class="text-slate-400 mt-3 text-base">
        Eliminate the dilemma between mobile app bundle size and enterprise-grade post-quantum cryptographic security.
      </p>
    </div>

    <!-- 4 Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {tpapPillars.map((pillar) => (
        <div class="unibase-card p-8 flex flex-col justify-between border border-white/10 relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-purple-500/0 group-hover:via-purple-400/60 to-transparent transition-all duration-500"></div>
          <div>
            <span class="text-xs font-mono font-semibold text-purple-400 uppercase tracking-wider block mb-2">
              {pillar.step}
            </span>
            <h3 class="text-2xl font-bold text-white mb-3">
              {pillar.title}
            </h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-6 font-light">
              {pillar.desc}
            </p>
          </div>
          <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-800">
            {pillar.tech.map((t) => (
              <span class="mono-tag text-[11px] bg-slate-900 text-slate-300 border-slate-800">
                {t}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Deep Dive: Multi-PSP Mesh Visualizer -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5">
    <div class="unibase-card p-8 sm:p-12 border border-white/10 bg-slate-950/80">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <span class="mono-tag font-semibold uppercase text-sky-400 border-sky-500/30 bg-sky-950/30">
            Resilient Infrastructure // Zero App Downtime
          </span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Active-Active Sponsor Bank Load Balancing
          </h3>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-light">
            TPAPs cannot afford to rely on a single sponsor bank. A temporary downtime at one partner bank during payday or evening peaks can wipe out tens of millions in GMV.
          </p>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-light">
            Gajalogic orchestrates an active-active mesh across up to 12 sponsor bank PSPs. Real-time synthetic pings measure round-trip latency, error code spikes, and NPCI decline indicators every 50 milliseconds—shifting intent payloads away from degraded banks in under 400 milliseconds without dropping in-flight sessions.
          </p>
          <div class="pt-2 flex flex-wrap gap-4 text-xs font-mono text-slate-400">
            <span class="flex items-center gap-1.5 text-sky-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Zero-Dropping Dynamic Session Hedging
            </span>
            <span class="flex items-center gap-1.5 text-purple-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              NPCI TPAP SAA (Security Assessment) Pre-Approved
            </span>
          </div>
        </div>

        <div class="lg:col-span-5 bg-slate-900/90 rounded-2xl p-6 border border-slate-800 font-mono text-xs text-slate-300 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-slate-800 text-slate-400">
            <span>MULTI_PSP_ROUTER_STATE</span>
            <span class="text-emerald-400">MESH ACTIVE</span>
          </div>
          <div class="flex justify-between items-center"><span class="text-slate-400">Sponsor Bank A (Primary):</span> <span class="text-emerald-400 font-bold">99.98% / 12ms</span></div>
          <div class="flex justify-between items-center"><span class="text-slate-400">Sponsor Bank B (Active):</span> <span class="text-emerald-400 font-bold">99.94% / 14ms</span></div>
          <div class="flex justify-between items-center"><span class="text-slate-400">Sponsor Bank C (Fallback):</span> <span class="text-amber-400 font-bold">DEGRADED / 92ms</span></div>
          <div class="p-2.5 rounded bg-slate-950 border border-slate-800 text-[11px] text-sky-300">
            ↳ Traffic auto-rerouted from Bank C to Bank A in 32ms. 0 intent sessions aborted.
          </div>
          <div><span class="text-purple-400">pqc_crypto_gateway:</span> <span class="text-slate-200">"ML-KEM-1024 SIDE-ENCLAVE"</span></div>
          <div><span class="text-purple-400">client_sdk_overhead:</span> <span class="text-emerald-400 font-bold">142 KB (Target &lt; 180 KB)</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Architectural Comparison Table -->
  <section id="comparison" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-mono uppercase tracking-widest text-sky-400 mb-2">Technical Matrix</h2>
      <h3 class="text-3xl font-extrabold text-white tracking-tight">
        Legacy Monolithic TPAP Stacks vs. Gajalogic Engine
      </h3>
      <p class="text-slate-400 mt-2 text-sm sm:text-base">
        A detailed comparison of mobile app agility, multi-bank resilience, and regulatory compliance velocity.
      </p>
    </div>

    <div class="unibase-card overflow-hidden border border-white/10 shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900/90 text-xs font-mono uppercase text-slate-400 border-b border-slate-800">
            <tr>
              <th class="px-6 py-4 w-1/4">Evaluation Category</th>
              <th class="px-6 py-4 w-3/8 text-rose-400">Legacy TPAP Middleware</th>
              <th class="px-6 py-4 w-3/8 text-purple-400 font-bold">Gajalogic Headless TPAP Engine</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-xs sm:text-sm">
            {tpapComparison.map((row) => (
              <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="px-6 py-4 font-mono font-semibold text-white bg-slate-950/40">
                  {row.dimension}
                </td>
                <td class="px-6 py-4 text-slate-400 leading-relaxed border-r border-slate-800">
                  {row.traditional}
                </td>
                <td class="px-6 py-4 text-slate-200 leading-relaxed bg-purple-950/10">
                  {row.gajalogic}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Executive CTA -->
  <CtaBanner
    title="Supercharge Your Consumer UPI App at Scale"
    subtitle="Integrate our ultralight headless SDK in under 48 hours and eliminate sponsor bank outage vulnerability forever."
    buttonText="Request TPAP Integration Kit"
    secondaryText="Explore NPCI Product Suite"
    secondaryHref={`${base}/products`}
  />
</Layout>

