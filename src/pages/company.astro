---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const companyMetrics = [
  { value: 'NPCI', label: 'Native Focus', sub: 'Built for India\u2019s rails, nothing else' },
  { value: 'PQC', label: 'First Principles', sub: 'Quantum-safety as a founding constraint' },
  { value: 'TCO', label: 'Debt Eradication', sub: 'Legacy licensing bloat eliminated' },
  { value: 'PoC', label: 'Deployment First', sub: 'Proof before procurement' },
];

const companySections = [
  {
    eyebrow: 'SECTION 01 // ABOUT',
    title: 'About & Mission',
    desc: 'The Gajalogic mission: securing India\u2019s digital public infrastructure for the next generation while eradicating the technical debt of the past. Principles, leadership, and engineering culture.',
    href: `${base}/company/about`,
    linkLabel: 'Read the Mission',
  },
  {
    eyebrow: 'SECTION 02 // INSIGHTS',
    title: 'Insights & Whitepapers',
    desc: 'High-level thought leadership: engineering whitepapers on TCO reduction, hardware supply chain optimization, and the timeline of the quantum threat.',
    href: `${base}/company/insights`,
    linkLabel: 'Browse Insights',
  },
  {
    eyebrow: 'SECTION 03 // CONTACT',
    title: 'Enterprise Contact',
    desc: 'Direct channels for enterprise sales inquiries, technical consultations, and proof-of-concept (PoC) deployments. Reach a payment systems architect, not a ticket queue.',
    href: `${base}/company/contact`,
    linkLabel: 'Contact the Team',
  },
];
---

<Layout
  title="Company | About GajaLogic, Insights & Contact"
  description="The Gajalogic mission, thought leadership on TCO and the quantum threat, and direct enterprise channels for sales, consultations, and PoC deployments."
>
  <PageHeader
    eyebrow="Company"
    title="Securing India's Digital Public Infrastructure"
    subtitle="The Gajalogic mission for the next generation of Indian payments — and the eradication of the technical debt of the past."
    badge="For Procurement, Executives & Press"
  >
    <div slot="actions">
      <a href="#sections" class="btn-unibase-primary !py-2.5 !px-5 !text-sm">
        Explore the Company
      </a>
      <a href={`${base}/company/contact`} class="btn-unibase-secondary !py-2.5 !px-5 !text-sm">
        Contact Sales
      </a>
    </div>
  </PageHeader>

  <!-- Metric Strip -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-16 relative z-10">
    <div class="unibase-card p-6 sm:p-8 shadow-sm">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 divide-y lg:divide-y-0 lg:divide-x divide-[#dadcdf]">
        {companyMetrics.map((m) => (
          <div class="pt-4 lg:pt-0 lg:px-4 text-center sm:text-left">
            <span class="text-xs font-mono uppercase tracking-wider text-[#3e61ff] block mb-1">{m.label}</span>
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[#0f1419] tracking-tight">{m.value}</div>
            <p class="text-xs text-gray-500 mt-1">{m.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Company Sections -->
  <section id="sections" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider mb-2 inline-block">Company Directory</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0f1419] tracking-tight mt-2">
        Three Doors Into Gajalogic
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {companySections.map((section, i) => (
        <div class="unibase-card p-8 flex flex-col justify-between relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#3e61ff]/0 group-hover:via-[#3e61ff]/40 to-transparent transition-all duration-500"></div>
          <div>
            <span class="text-xs font-mono font-bold text-[#3e61ff] mb-3 block">0{i + 1} //</span>
            <span class="text-xs font-mono font-bold text-[#3e61ff] uppercase tracking-wider block mb-2">
              {section.eyebrow}
            </span>
            <h3 class="text-2xl font-extrabold text-[#0f1419] mb-3">
              {section.title}
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              {section.desc}
            </p>
          </div>
          <a
            href={section.href}
            class="inline-flex items-center text-sm font-bold text-[#3e61ff] group-hover:text-[#3151e6] group-hover:translate-x-1 transition-all"
          >
            <span>{section.linkLabel}</span>
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Mission Statement -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[#dadcdf]">
    <div class="max-w-3xl mx-auto text-center">
      <span class="mono-tag font-semibold uppercase tracking-wider mb-4 inline-block">Mission</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0f1419] tracking-tight leading-snug">
        "Securing India's digital public infrastructure for the <span class="text-[#3e61ff]">next generation</span> — while eradicating the technical debt of the past."
      </h2>
      <p class="text-gray-500 mt-6 text-sm sm:text-base">
        Every rupee moving over UPI, IMPS, RuPay, and NCMC deserves infrastructure that is both affordable to operate and safe to trust for decades. That combination — cost discipline and quantum-era security — is the entire company.
      </p>
    </div>
  </section>

  <CtaBanner
    title="Talk to a Payment Systems Architect"
    subtitle="Enterprise sales, technical consultations, and PoC deployments — reach the engineers directly."
    buttonText="Contact the Team"
    buttonHref={`${base}/company/contact`}
    secondaryText="View the NPCI Product Suite"
    secondaryHref={`${base}/products`}
  />
</Layout>
