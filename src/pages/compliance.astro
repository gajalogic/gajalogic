---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const certifications = [
  {
    id: 'soc2',
    code: 'SOC 2 Type II',
    title: 'AICPA Trust Services Criteria',
    desc: 'Audited annually by independent top-tier auditors across Security, Availability, and Confidentiality controls with zero findings.',
    status: 'Active / Continuous Monitoring',
    auditDate: 'Audited Q4 2026',
  },
  {
    id: 'iso27001',
    code: 'ISO/IEC 27001:2022',
    title: 'Information Security Management System (ISMS)',
    desc: 'Comprehensive organizational security standard covering development lifecycle, physical datacenter controls, and cryptographic key governance.',
    status: 'Certified / Global Scope',
    auditDate: 'Recertified 2026',
  },
  {
    id: 'fips',
    code: 'FIPS 140-3 Level 4',
    title: 'Cryptographic Module Validation Program (CMVP)',
    desc: 'Highest tier of hardware physical security validation featuring active physical tamper shielding and immediate automated key zeroization upon breach.',
    status: 'NIST Certificate #4819',
    auditDate: 'Hardware Validated',
  },
  {
    id: 'hipaa',
    code: 'HIPAA & HITECH',
    title: 'Healthcare Patient Privacy Compliance',
    desc: 'Ensures electronic Protected Health Information (ePHI) processed on GajaLogic nodes remains encrypted in memory, at rest, and across networks.',
    status: 'BAA Ready',
    auditDate: 'Verified Compliant',
  },
  {
    id: 'gdpr',
    code: 'GDPR & Sovereign Data',
    title: 'Air-Gapped Sovereign Data Residency',
    desc: 'No telemetry or model weights ever leave client premises. Fully compliant with EU Schrems II ruling and stringent national data sovereignty mandates.',
    status: '100% On-Premise',
    auditDate: 'Sovereign Guarantee',
  },
  {
    id: 'eal4',
    code: 'Common Criteria EAL4+',
    title: 'Evaluation Assurance Level 4 Augmented',
    desc: 'Rigorous formal design verification and independent vulnerability testing of the Logic-OS microkernel and memory virtualization layers.',
    status: 'Targeted Evaluation',
    auditDate: 'In Review 2026',
  },
];

const securityPillars = [
  {
    title: 'Hardware Bill of Materials (HBOM)',
    desc: 'Every integrated circuit, capacitor, and PCB trace is cryptographically signed and tracked throughout our Western-allied supply chain.',
  },
  {
    title: 'Zero-Telemetry Architecture',
    desc: 'GajaLogic nodes operate 100% air-gapped without mandatory cloud phones-home, telemetry phoning, or background license checks.',
  },
  {
    title: 'Cold-Boot Attack Mitigation',
    desc: 'Memory contents are scrambled with volatile physical unclonable function (PUF) keys that vanish within 10 nanoseconds of power loss.',
  },
  {
    title: 'Firmware Attestation',
    desc: 'Cryptographic boot measurements are stored in hardware TPM 2.0 registers to prevent unauthorized kernel rootkits or hypervisor tampering.',
  },
];
---

<Layout
  title="Compliance & Trust | GajaLogic Sovereign Certifications"
  description="GajaLogic compliance standards: SOC 2 Type II, ISO 27001, FIPS 140-3 Level 4, HIPAA, and sovereign air-gapped infrastructure."
>
  <PageHeader
    eyebrow="Security & Governance"
    title="Sovereign Compliance & Trust"
    subtitle="Engineered from the silicon layer up to satisfy the strictest defense, intelligence, financial, and healthcare data sovereignty mandates."
    badge="Enterprise Trust Center"
  >
    <div slot="actions">
      <a
        href="#certifications"
        class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-sky-400 text-slate-950 hover:bg-sky-300 shadow-sm transition-colors"
      >
        View Certifications
      </a>
      <a
        href="#security"
        class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-slate-800 text-slate-200 hover:text-white border border-slate-700 transition-colors"
      >
        Security Architecture
      </a>
    </div>
  </PageHeader>

  <!-- Certifications Grid -->
  <section id="certifications" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-xs font-mono uppercase text-sky-400 tracking-widest mb-2">Verified Standards</h2>
      <h3 class="text-3xl font-extrabold text-white">Regulatory Certifications</h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {certifications.map((c) => (
        <div id={c.id} class="glass-panel glass-panel-hover rounded-2xl p-7 flex flex-col justify-between border border-white/10">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20">
                {c.code}
              </span>
              <span class="text-[11px] font-mono text-emerald-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                {c.status}
              </span>
            </div>
            <h4 class="text-lg font-bold text-white mb-2">{c.title}</h4>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
              {c.desc}
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800 flex items-center justify-between text-xs font-mono text-slate-400">
            <span>{c.auditDate}</span>
            <a href={`${base}/company#contact`} class="text-sky-400 hover:text-sky-300">Request Audit Package →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Security Deep Dive -->
  <section id="security" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5 space-y-12">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2 class="text-xs font-mono uppercase text-sky-400 tracking-widest mb-2">Defense In Depth</h2>
      <h3 class="text-3xl font-extrabold text-white">Hardware & Silicon Security Controls</h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {securityPillars.map((p) => (
        <div class="glass-panel rounded-2xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 text-sky-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <h4 class="text-base font-bold text-white mb-2">{p.title}</h4>
          <p class="text-xs text-slate-300 leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Vulnerability Disclosure & Audit Report Access -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-white/10 bg-slate-900/50 flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <h3 class="text-2xl font-bold text-white mb-2">Request Auditor Reports & SOC 3</h3>
        <p class="text-sm text-slate-300 max-w-xl">
          Authorized enterprise risk officers, compliance assessors, and CISOs can request our complete third-party audit reports and penetration testing summaries under NDA.
        </p>
      </div>
      <a
        href={`${base}/company#contact`}
        class="shrink-0 px-6 py-3 rounded-xl text-sm font-semibold bg-sky-400 text-slate-950 hover:bg-sky-300 transition-colors"
      >
        Request Compliance Documentation
      </a>
    </div>
  </section>

  <CtaBanner
    title="Require Custom Government or Sovereign Accreditation?"
    subtitle="Our dedicated security compliance team collaborates with national defense and governmental bodies on bespoke security requirements."
    buttonText="Schedule Security Briefing"
  />
</Layout>
