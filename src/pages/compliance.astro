---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const complianceMetrics = [
  { value: '2027', label: 'GoI PQC Deadline', sub: 'BFSI PQC foundations mandated' },
  { value: 'Q-SAFE', label: 'RBI Alignment', sub: 'Committee requirements mapped' },
  { value: 'PA-P', label: 'Authorization Ready', sub: 'Operational metrics natively supported' },
  { value: 'CBOM', label: 'Audit Mastery', sub: 'Automated crypto asset inventory' },
];

const compliancePillars = [
  {
    eyebrow: 'TRUST 01 // REGULATORY',
    title: 'RBI Q-SAFE Alignment',
    desc: 'Proactive compliance: the Gajalogic platform maps directly to the Government of India PQC Task Force deadlines mandating PQC foundations for BFSI by 2027, and to upcoming RBI Q-SAFE committee requirements.',
    href: `${base}/compliance/rbi-qsafe`,
    linkLabel: 'View Regulatory Alignment',
    iconPath: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    eyebrow: 'TRUST 02 // AUTHORIZATION',
    title: 'PA-P Framework',
    desc: 'Operational readiness: validates that the system architecture and operational metrics natively support the stringent compliance and reporting requirements for physical Payment Aggregator (PA-P) authorization.',
    href: `${base}/compliance/pa-p-framework`,
    linkLabel: 'View the PA-P Framework',
    iconPath: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    eyebrow: 'TRUST 03 // AUDIT',
    title: 'Cryptographic Bill of Materials',
    desc: 'Audit mastery: a clear, downloadable CBOM framework. Gajalogic inventories and secures every cryptographic asset across the network, transforming a complex risk audit into a seamless, automated reporting process.',
    href: `${base}/compliance/cbom`,
    linkLabel: 'View the CBOM Framework',
    iconPath: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
];

const enterpriseHygiene = [
  { name: 'SOC 2 Type II', note: 'Annual independent audit across security, availability & confidentiality' },
  { name: 'ISO/IEC 27001:2022', note: 'ISMS covering development lifecycle & cryptographic key governance' },
  { name: 'FIPS 140-3 (HSM)', note: 'Validated cryptographic modules at the enterprise root of trust' },
  { name: 'DPDP Act 2023', note: 'Data principal consent & purpose limitation aligned by design' },
];
---

<Layout
  title="Compliance & Trust Center | GajaLogic Regulatory Alignment"
  description="RBI Q-SAFE and GoI PQC Task Force 2027 alignment, PA-P authorization readiness, and an automated Cryptographic Bill of Materials framework."
>
  <PageHeader
    eyebrow="Compliance & Trust Center"
    title="Proactive Compliance, Documented Trust"
    subtitle="For CISOs, risk officers, and compliance heads: regulatory alignment mapped to mandates, authorization readiness built into operations, and audits turned into automated reports."
    badge="For CISOs & Risk Officers"
  >
    <div slot="actions">
      <a href="#pillars" class="btn-unibase-primary !py-2.5 !px-5 !text-sm">
        Explore the Trust Center
      </a>
      <a href={`${base}/compliance/cbom`} class="btn-unibase-secondary !py-2.5 !px-5 !text-sm">
        Jump to CBOM
      </a>
    </div>
  </PageHeader>

  <!-- Metric Strip -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-16 relative z-10">
    <div class="unibase-card p-6 sm:p-8 shadow-sm">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 divide-y lg:divide-y-0 lg:divide-x divide-[#dadcdf]">
        {complianceMetrics.map((m) => (
          <div class="pt-4 lg:pt-0 lg:px-4 text-center sm:text-left">
            <span class="text-xs font-mono uppercase tracking-wider text-[#3e61ff] block mb-1">{m.label}</span>
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[#0f1419] tracking-tight">{m.value}</div>
            <p class="text-xs text-gray-500 mt-1">{m.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Three Trust Pillars -->
  <section id="pillars" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider mb-2 inline-block">Trust Deep Dives</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0f1419] tracking-tight mt-2">
        Three Pillars of the Trust Center
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {compliancePillars.map((pillar) => (
        <div class="unibase-card p-8 flex flex-col justify-between relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#3e61ff]/0 group-hover:via-[#3e61ff]/40 to-transparent transition-all duration-500"></div>
          <div>
            <div class="p-3 w-fit rounded-xl bg-blue-50 border border-blue-200 text-[#3e61ff] mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={pillar.iconPath}/>
              </svg>
            </div>
            <span class="text-xs font-mono font-bold text-[#3e61ff] uppercase tracking-wider block mb-2">
              {pillar.eyebrow}
            </span>
            <h3 class="text-2xl font-extrabold text-[#0f1419] mb-3">
              {pillar.title}
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              {pillar.desc}
            </p>
          </div>
          <a
            href={pillar.href}
            class="inline-flex items-center text-sm font-bold text-[#3e61ff] group-hover:text-[#3151e6] group-hover:translate-x-1 transition-all"
          >
            <span>{pillar.linkLabel}</span>
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Enterprise Hygiene -->
  <section id="certifications" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[#dadcdf]">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-[#3e61ff] mb-2">Enterprise Hygiene</h2>
      <h3 class="text-3xl font-extrabold text-[#0f1419] tracking-tight">
        Baseline Certifications
      </h3>
      <p class="text-gray-500 mt-2 text-sm sm:text-base">
        Regulatory-specific programs sit on top of a disciplined baseline. Audit packages are available under NDA.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {enterpriseHygiene.map((c) => (
        <div class="unibase-card p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="mono-tag">{c.name}</span>
            <span class="text-[11px] font-mono text-emerald-600 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Active
            </span>
          </div>
          <p class="text-xs text-gray-600 leading-relaxed">{c.note}</p>
        </div>
      ))}
    </div>
  </section>

  <CtaBanner
    title="Request the Full Audit Package"
    subtitle="Risk officers and CISOs can request regulator-aligned documentation, the CBOM export format, and the PA-P operational metrics pack under NDA."
    buttonText="Request Compliance Documentation"
    buttonHref={`${base}/company/contact`}
    secondaryText="View Developer Resources"
    secondaryHref={`${base}/developers`}
  />
</Layout>
