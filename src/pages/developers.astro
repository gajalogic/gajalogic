---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const devMetrics = [
  { value: 'Show', label: "Don't Tell", sub: 'Proof before pitch — always' },
  { value: 'Live', label: 'Interactive Sandbox', sub: 'Simulated UPI pay/collect flows' },
  { value: 'Mermaid', label: 'Open Blueprints', sub: 'Downloadable architecture diagrams' },
  { value: 'Spec-Driven', label: 'Test Harness', sub: 'Playwright + DuckDB verification' },
];

const devPillars = [
  {
    eyebrow: 'RESOURCE 01 // SANDBOX',
    title: 'Live Interactive Demo',
    desc: 'A web-based terminal where engineers can initiate simulated UPI pay/collect requests and visualize the hybrid PQC key exchange in real time. No sales call, no NDA — just open the terminal and watch the switch negotiate.',
    href: `${base}/developers/sandbox`,
    linkLabel: 'Open the Sandbox',
    iconPath: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
  {
    eyebrow: 'RESOURCE 02 // BLUEPRINTS',
    title: 'Transparent Architecture',
    desc: 'Downloadable Mermaid.js diagrams mapping exactly how Gajalogic interfaces with your existing microservices, core banking, and NPCI rails. Nothing to hide — integrate against the real topology, not a slide.',
    href: `${base}/developers/architecture`,
    linkLabel: 'View the Blueprints',
    iconPath: 'M9 17V7m0 10h6m3-13H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2z',
  },
  {
    eyebrow: 'RESOURCE 03 // DOCS & TESTS',
    title: 'Rigorous Test Harness',
    desc: 'API references plus a rigorous test suite utilizing Playwright and DuckDB for automated, spec-driven code verification. If our documentation lies, our test harness fails loudly.',
    href: `${base}/developers/docs`,
    linkLabel: 'Read the Docs',
    iconPath: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
];

const quickstartSteps = [
  { step: '01', title: 'Open the Sandbox', desc: 'Launch the simulated terminal and fire a UPI pay request against the mock NPCI fabric.', cmd: 'open /developers/sandbox' },
  { step: '02', title: 'Watch the Key Exchange', desc: 'Observe the hybrid X25519 + ML-KEM handshake negotiate in the PQC visualizer panel.', cmd: 'sandbox watch --pqc-handshake' },
  { step: '03', title: 'Wire Your Service', desc: 'Pull a Mermaid blueprint, point your microservice at the adapter spec, and run the test harness.', cmd: 'gajalogic test --spec upi-acquiring' },
];
---

<Layout
  title="Developers | GajaLogic Sandbox, Blueprints & Test Harness"
  description="Live interactive UPI/PQC sandbox, downloadable Mermaid architecture blueprints, and a rigorous Playwright + DuckDB test harness for integrators."
>
  <PageHeader
    eyebrow="Developers & Migration"
    title="Enterprise Developers Demand Proof"
    subtitle="Show, don't tell. A live sandbox, transparent blueprints, and a rigorous test harness — everything an integrator needs to verify Gajalogic before committing a sprint."
    badge="Show, Don't Tell"
  >
    <div slot="actions">
      <a href="#pillars" class="btn-unibase-primary !py-2.5 !px-5 !text-sm">
        Explore Developer Resources
      </a>
      <a href={`${base}/developers/sandbox`} class="btn-unibase-secondary !py-2.5 !px-5 !text-sm">
        Jump to the Sandbox
      </a>
    </div>
  </PageHeader>

  <!-- Metric Strip -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-16 relative z-10">
    <div class="unibase-card p-6 sm:p-8 shadow-sm">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 divide-y lg:divide-y-0 lg:divide-x divide-[#dadcdf]">
        {devMetrics.map((m) => (
          <div class="pt-4 lg:pt-0 lg:px-4 text-center sm:text-left">
            <span class="text-xs font-mono uppercase tracking-wider text-[#3e61ff] block mb-1">{m.label}</span>
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[#0f1419] tracking-tight">{m.value}</div>
            <p class="text-xs text-gray-500 mt-1">{m.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Three Developer Pillars -->
  <section id="pillars" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider mb-2 inline-block">Integration Resources</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0f1419] tracking-tight mt-2">
        Three Ways to Verify Before You Trust
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {devPillars.map((pillar) => (
        <div class="unibase-card p-8 flex flex-col justify-between relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#3e61ff]/0 group-hover:via-[#3e61ff]/40 to-transparent transition-all duration-500"></div>
          <div>
            <div class="p-3 w-fit rounded-xl bg-blue-50 border border-blue-200 text-[#3e61ff] mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={pillar.iconPath}/>
              </svg>
            </div>
            <span class="text-xs font-mono font-bold text-[#3e61ff] uppercase tracking-wider block mb-2">
              {pillar.eyebrow}
            </span>
            <h3 class="text-2xl font-extrabold text-[#0f1419] mb-3">
              {pillar.title}
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              {pillar.desc}
            </p>
          </div>
          <a
            href={pillar.href}
            class="inline-flex items-center text-sm font-bold text-[#3e61ff] group-hover:text-[#3151e6] group-hover:translate-x-1 transition-all"
          >
            <span>{pillar.linkLabel}</span>
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Quick Start -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[#dadcdf]">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-[#3e61ff] mb-2">Getting Started</h2>
      <h3 class="text-3xl font-extrabold text-[#0f1419] tracking-tight">
        From Zero to First Verified Transaction
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {quickstartSteps.map((s) => (
        <div class="unibase-card p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono font-bold text-[#3e61ff] mb-3 block">{s.step} //</span>
            <h4 class="text-lg font-bold text-[#0f1419] mb-2">{s.title}</h4>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{s.desc}</p>
          </div>
          <div class="p-3 bg-gray-50 rounded-xl border border-[#dadcdf] font-mono text-xs text-[#3e61ff]">
            {s.cmd}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CtaBanner
    title="Bring Your Integration Team Into the Sandbox"
    subtitle="Give your engineers hands-on time with the simulated switch fabric and PQC visualizer before any procurement conversation begins."
    buttonText="Open the PQC Migration Sandbox"
    buttonHref={`${base}/developers/sandbox`}
    secondaryText="Contact the Integration Team"
    secondaryHref={`${base}/company/contact`}
  />
</Layout>
