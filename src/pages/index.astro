---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const whyPoints = [
  {
    title: 'The TCO Paradigm Shift',
    desc: 'Monolithic legacy switches penalize banks with volume-tiered licenses. Gajalogic replaces this with an elastic cloud-native stack, cutting 5-year TCO by up to 64%.',
    iconBg: 'bg-emerald-50 text-emerald-600 border-emerald-200',
    iconPath: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Quantum-Safe by Design',
    desc: 'Securing in-flight payloads and at-rest ledgers with NIST FIPS 203 (ML-KEM) and FIPS 204 (ML-DSA) to neutralize the "Harvest Now, Decrypt Later" threat.',
    iconBg: 'bg-purple-50 text-purple-600 border-purple-200',
    iconPath: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Core Banking Shield',
    desc: 'In-memory balance virtualization offloads 84.6% of non-financial queries, completely insulating legacy CBS databases (Finacle, BaNCS) from spike outages.',
    iconBg: 'bg-amber-50 text-amber-600 border-amber-200',
    iconPath: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'Hybrid Crypto-Agility',
    desc: 'Classical RSA/ECC and Post-Quantum algorithms execute in parallel, ensuring 100% seamless backward compatibility across all NPCI rails without downtime.',
    iconBg: 'bg-blue-50 text-[#3e61ff] border-blue-200',
    iconPath: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  },
];

const useCases = [
  {
    title: 'Tier-1 Bank Issuing',
    desc: 'Shield core banking systems during salary peaks, virtualize account balances, and protect long-lived customer metadata against future quantum decryption.',
    badge: 'BANK CTOs',
    link: `${base}/products/upi-issuing`,
  },
  {
    title: 'Payment Aggregators (PA-Ps)',
    desc: 'Handle 75,000+ peak TPS during Diwali and flash sales with sub-millisecond distributed sagas, O(1) in-memory VPA lookups, and quantum-safe settlement logs.',
    badge: 'MERCHANT SCALE',
    link: `${base}/products/upi-acquiring`,
  },
  {
    title: 'Metro & Mass Transit (NCMC)',
    desc: 'Deterministic sub-240ms turnstile gate taps with zero-leakage offline stored value ledgers and ultra-compact 48KB smart card silicon cryptography.',
    badge: 'SMART MOBILITY',
    link: `${base}/products/ncmc-transit`,
  },
];

const blogPosts = [
  {
    tag: 'CRYPTOGRAPHY // ARCHITECTURE',
    title: 'Neutralizing the "Harvest Now, Decrypt Later" Threat in National BFSI',
    date: 'NOVEMBER 2026',
    excerpt: 'How hostile intelligence services intercept encrypted banking feeds today, and why NIST FIPS 203 ML-KEM lattice encapsulation is critical before Q-Day.',
    link: `${base}/compliance`,
  },
  {
    tag: 'FINANCIAL AUDIT // TCO SIZING',
    title: 'Eradicating Legacy Per-TPS Licensing: A BCG-Standard Sizing Audit',
    date: 'OCTOBER 2026',
    excerpt: 'Detailed financial modeling showing how moving from monolithic switches to cloud-native compute delivers a 64% net operational expenditure reduction.',
    link: `${base}/products`,
  },
  {
    tag: 'HIGH-THROUGHPUT SWITCHING',
    title: 'In-Memory Sub-Millisecond Distributed Sagas under 75,000 Festival TPS',
    date: 'SEPTEMBER 2026',
    excerpt: 'Architectural breakdown of lock-free actor models, zero-copy buffer rings, and automated UDIR resolution during peak Indian payment spikes.',
    link: `${base}/platform`,
  },
];

const faqs = [
  {
    q: 'How does Gajalogic achieve sub-millisecond latency while running Post-Quantum Cryptography?',
    a: 'Gajalogic implements zero-copy memory ring buffers and hardware-accelerated lattice mathematics (ML-KEM / ML-DSA). Cryptographic handshakes and digital signatures execute asynchronously alongside the distributed saga pipeline, maintaining an internal switch P99 latency of <0.82ms.',
  },
  {
    q: 'What is the "Harvest Now, Decrypt Later" (HNDL) threat and why must banks act today?',
    a: 'Adversary state intelligence networks continuously intercept and archive encrypted banking data across public telecommunication lines. Long-lived identifiers (account numbers, Aadhaar linkages, historical transaction records) remain sensitive for decades. When Cryptanalytically Relevant Quantum Computers (CRQCs) arrive, classical RSA/ECC will be cracked instantaneously. Gajalogic neutralizes this threat by sealing data in quantum-intractable lattice envelopes today.',
  },
  {
    q: 'How does Gajalogic eliminate legacy per-TPS licensing taxes?',
    a: 'Legacy switches like Base24 and Way4 charge tiered per-transaction licensing penalties that escalate exponentially as UPI volume grows. Gajalogic provides an elastic compute-capacity model running on standard Kubernetes and commodity hardware—meaning zero per-transaction penalties regardless of whether your bank processes 1 million or 100 million transactions daily.',
  },
  {
    q: 'Can Gajalogic integrate seamlessly with our existing Core Banking System (CBS)?',
    a: 'Yes. Gajalogic supports plug-and-play ISO 8583, ISO 20022, and modern REST/gRPC interfaces compatible with Infosys Finacle, TCS BaNCS, and Oracle Flexcube. Its in-memory shadow ledger intercepts 84.6% of read and balance queries, directly shielding core banking databases from lock contention and high-concurrency crashes.',
  },
  {
    q: 'Is Gajalogic compliant with NPCI and Government of India PQC Task Force mandates?',
    a: 'Yes. Gajalogic natively adheres to all NPCI UPI, RuPay, and NCMC specifications while proactively aligning with the Government of India Post-Quantum Cryptography Task Force (mandating PQC foundations for Indian BFSI by 2027) and upcoming RBI Q-SAFE standards.',
  },
];
---

<Layout
  title="GajaLogic — Open Payment Layer for National Rails"
  description="Open, quantum-safe payment infrastructure for high-throughput national rails. High-throughput UPI and IMPS switches embedded with Post-Quantum Cryptography."
>
  <!-- 1. Top Panoramic Illustrated Banner (Exact Unibase Artwork Banner) -->
  <section class="w-full bg-[#f8f9fc] border-b border-[#dadcdf] overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-2">
      <div class="relative w-full h-44 sm:h-56 md:h-64 rounded-2xl overflow-hidden border border-[#dadcdf] shadow-sm bg-gradient-to-r from-blue-900 via-indigo-900 to-sky-900 flex items-center justify-center">
        <!-- Stylized Sci-Fi Panoramic Vector Art -->
        <svg class="absolute inset-0 w-full h-full object-cover opacity-85" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice" fill="none">
          <defs>
            <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1e3a8a"/>
              <stop offset="40%" stop-color="#3b82f6"/>
              <stop offset="80%" stop-color="#93c5fd"/>
              <stop offset="100%" stop-color="#fed7aa"/>
            </linearGradient>
            <linearGradient id="mountGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1e1b4b"/>
              <stop offset="100%" stop-color="#0f172a"/>
            </linearGradient>
          </defs>
          <rect width="1200" height="400" fill="url(#skyGrad)"/>
          <!-- Distant futuristic city skyline / network towers -->
          <polygon points="100,260 120,180 140,260" fill="#312e81" opacity="0.6"/>
          <polygon points="135,260 150,140 165,260" fill="#1e1b4b" opacity="0.7"/>
          <polygon points="280,260 310,120 340,260" fill="#1e3a8a" opacity="0.5"/>
          <polygon points="750,260 780,100 810,260" fill="#1e1b4b" opacity="0.7"/>
          <polygon points="800,260 830,160 860,260" fill="#312e81" opacity="0.6"/>
          <!-- Mountain ridges -->
          <path d="M0,280 Q180,210 380,270 T800,240 T1200,270 L1200,400 L0,400 Z" fill="url(#mountGrad)"/>
          <path d="M0,320 Q250,280 550,330 T1050,300 T1200,320 L1200,400 L0,400 Z" fill="#020617"/>
          <!-- Stylized Explorer / Engineer Figures standing in desert/landscape -->
          <g transform="translate(420, 275) scale(0.65)">
            <ellipse cx="25" cy="18" rx="8" ry="10" fill="#f8fafc"/>
            <rect x="18" y="26" width="14" height="28" rx="4" fill="#e2e8f0"/>
            <rect x="16" y="52" width="6" height="26" rx="2" fill="#94a3b8"/>
            <rect x="26" y="52" width="6" height="26" rx="2" fill="#94a3b8"/>
            <circle cx="25" cy="18" r="5" fill="#38bdf8"/>
          </g>
          <g transform="translate(560, 270) scale(0.7)">
            <ellipse cx="25" cy="18" rx="8" ry="10" fill="#f8fafc"/>
            <rect x="18" y="26" width="14" height="28" rx="4" fill="#e2e8f0"/>
            <rect x="16" y="52" width="6" height="26" rx="2" fill="#94a3b8"/>
            <rect x="26" y="52" width="6" height="26" rx="2" fill="#94a3b8"/>
            <circle cx="25" cy="18" r="5" fill="#60a5fa"/>
          </g>
          <g transform="translate(680, 278) scale(0.62)">
            <ellipse cx="25" cy="18" rx="8" ry="10" fill="#f8fafc"/>
            <rect x="18" y="26" width="14" height="28" rx="4" fill="#e2e8f0"/>
            <rect x="16" y="52" width="6" height="26" rx="2" fill="#94a3b8"/>
            <rect x="26" y="52" width="6" height="26" rx="2" fill="#94a3b8"/>
            <circle cx="25" cy="18" r="5" fill="#38bdf8"/>
          </g>
          <!-- Geometric Network constellation lines -->
          <line x1="150" y1="140" x2="310" y2="120" stroke="#60a5fa" stroke-width="1.5" stroke-dasharray="4,4" opacity="0.7"/>
          <line x1="310" y1="120" x2="780" y2="100" stroke="#60a5fa" stroke-width="1.5" stroke-dasharray="4,4" opacity="0.7"/>
          <line x1="780" y1="100" x2="1050" y2="140" stroke="#60a5fa" stroke-width="1.5" stroke-dasharray="4,4" opacity="0.7"/>
          <circle cx="310" cy="120" r="4" fill="#38bdf8"/>
          <circle cx="780" cy="100" r="4" fill="#38bdf8"/>
        </svg>

        <div class="relative z-10 text-center text-white px-4">
          <span class="inline-block text-[11px] font-mono tracking-widest uppercase bg-black/40 backdrop-blur-md px-3 py-1 rounded-full border border-white/20 mb-1">
            NATIONAL PAYMENT SWITCH INFRASTRUCTURE // PQC ENCLAVE
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Hero Section (Clean Centered Unibase Layout) -->
  <section class="pt-12 pb-16 md:pt-16 md:pb-24 bg-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Headline with Signature Blue Highlight -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-[#0f1419] leading-[1.1] mb-6">
        Open Payment Layer<br />
        For <span class="text-[#3e61ff]">National Rails</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto mb-8 font-normal">
        High-throughput UPI and IMPS switches embedded with Post-Quantum Cryptography (PQC). Eradicate legacy licensing bloat while neutralizing the "Harvest Now, Decrypt Later" threat.
      </p>

      <!-- Primary Blue Button -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-4">
        <a
          href={`${base}/products`}
          class="btn-unibase-primary !py-3.5 !px-8 !text-base"
        >
          View Architecture
        </a>
      </div>

      <div class="text-xs text-gray-400">
        <a href={`${base}/developers`} class="hover:text-[#3e61ff] transition-colors">
          Access PQC Migration Sandbox &rarr;
        </a>
      </div>

    </div>
  </section>

  <!-- 3. "Why Unibase" / "Why Gajalogic" (4 Modular White Cards) -->
  <section class="py-16 md:py-24 bg-white border-t border-[#dadcdf]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0f1419] tracking-tight">
          Why <span class="text-[#3e61ff]">Gajalogic</span>
        </h2>
        <p class="text-sm sm:text-base text-gray-500 mt-3">
          The dual imperative of TCO reduction and post-quantum readiness for India's digital payment ecosystem.
        </p>
      </div>

      <!-- 4 Clean 1px Bordered White Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {whyPoints.map((item) => (
          <div class="unibase-card p-6 flex flex-col justify-between">
            <div>
              <!-- Colorful vector badge icon in top left -->
              <div class={`w-10 h-10 rounded-xl flex items-center justify-center border mb-5 ${item.iconBg}`}>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.iconPath}/>
                </svg>
              </div>

              <h3 class="text-lg font-bold text-[#0f1419] mb-2">
                {item.title}
              </h3>

              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. Section Divider Callout Banner -->
  <section class="py-14 bg-white text-center border-t border-[#dadcdf]">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#0f1419] tracking-tight">
        Build the <span class="text-[#3e61ff]">Quantum-Safe Payment Internet</span>
      </h2>
    </div>
  </section>

  <!-- 5. "The Gajalogic Stack" (2 Wide Cards Side-by-Side) -->
  <section class="py-16 bg-white border-t border-[#dadcdf]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0f1419] tracking-tight">
            The Gajalogic <span class="text-[#3e61ff]">Stack</span>
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-gray-500 max-w-md">
          A decoupled, cloud-native architecture combining high-concurrency micro-sagas with hardware-isolated lattice cryptography.
        </p>
      </div>

      <!-- 2 Wide Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Stack Card 1 -->
        <div class="unibase-card p-8 flex flex-col justify-between relative overflow-hidden group">
          <div class="space-y-4">
            <span class="text-xs font-mono font-bold text-[#3e61ff] uppercase tracking-wider">
              SWITCH CORE // TIER 1
            </span>
            <h3 class="text-2xl font-extrabold text-[#0f1419]">
              High-Throughput Saga Switch
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Sub-millisecond distributed saga state machine with in-memory O(1) VPA routing tables. Sits in front of core banking to absorb 75,000+ peak TPS without database locks.
            </p>
            <div class="pt-2">
              <a href={`${base}/platform`} class="text-xs font-bold text-[#3e61ff] hover:underline inline-flex items-center gap-1">
                <span>Inspect Saga Architecture</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
          <!-- Corner Isometric Graphic -->
          <div class="mt-6 flex justify-end">
            <svg class="w-20 h-20 text-blue-500/80 transition-transform group-hover:scale-110" viewBox="0 0 80 80" fill="none">
              <polygon points="40,10 70,25 40,40 10,25" fill="#3e61ff" opacity="0.8"/>
              <polygon points="10,25 40,40 40,70 10,55" fill="#2563eb" opacity="0.9"/>
              <polygon points="40,40 70,25 70,55 40,70" fill="#1d4ed8"/>
            </svg>
          </div>
        </div>

        <!-- Stack Card 2 -->
        <div class="unibase-card p-8 flex flex-col justify-between relative overflow-hidden group">
          <div class="space-y-4">
            <span class="text-xs font-mono font-bold text-purple-600 uppercase tracking-wider">
              SECURITY // ENCLAVE
            </span>
            <h3 class="text-2xl font-extrabold text-[#0f1419]">
              Post-Quantum Cryptographic Enclave
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              NIST FIPS 203 (ML-KEM) and FIPS 204 (ML-DSA) hardware root-of-trust. Encapsulates in-flight transactions and signs settlement ledgers, permanently defeating "Harvest Now, Decrypt Later".
            </p>
            <div class="pt-2">
              <a href={`${base}/compliance`} class="text-xs font-bold text-[#3e61ff] hover:underline inline-flex items-center gap-1">
                <span>View PQC Specifications</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
          <!-- Corner Isometric Graphic -->
          <div class="mt-6 flex justify-end">
            <svg class="w-20 h-20 text-purple-500/80 transition-transform group-hover:scale-110" viewBox="0 0 80 80" fill="none">
              <polygon points="40,10 70,25 40,40 10,25" fill="#9333ea" opacity="0.8"/>
              <polygon points="10,25 40,40 40,70 10,55" fill="#7e22ce" opacity="0.9"/>
              <polygon points="40,40 70,25 70,55 40,70" fill="#6b21a8"/>
            </svg>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 6. Alternating Zig-Zag Feature Blocks (AIP Protocol, Unibase Pay, Unibase DA) -->
  <section class="py-16 md:py-24 bg-white border-t border-[#dadcdf] space-y-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <!-- Block 1: Left Text, Right Graphic Card (AIP Protocol) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-4">
          <span class="text-xs font-mono font-bold text-[#3e61ff] uppercase tracking-wider block">
            HIGH-THROUGHPUT ENGINE
          </span>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-[#0f1419] tracking-tight">
            AIP Switch Protocol
          </h3>
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            The Gajalogic AIP (Autonomous Interoperability Protocol) coordinates sub-millisecond payment authorization across remitter banks, beneficiary aggregators, and NPCI Unified Switch rails.
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-gray-600 pt-2">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#3e61ff]"></span>
              <span>O(1) in-memory VPA resolution in &lt;140 microseconds</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#3e61ff]"></span>
              <span>Zero-lock non-blocking distributed saga actor execution</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#3e61ff]"></span>
              <span>Active-active sponsor bank load balancing and sub-second failover</span>
            </li>
          </ul>
          <div class="pt-3">
            <a href={`${base}/products/upi-acquiring`} class="text-sm font-bold text-[#3e61ff] hover:underline inline-flex items-center gap-1">
              <span>Explore AIP Acquiring Rail</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="unibase-card overflow-hidden shadow-lg p-2 bg-gradient-to-tr from-slate-900 to-blue-950">
            <!-- Stylized Cybernetic Engineering Card Graphic (as in screenshot) -->
            <div class="w-full h-80 sm:h-96 rounded-xl relative overflow-hidden bg-[#0c1222] p-6 flex flex-col justify-between text-white">
              <div class="flex items-center justify-between text-[11px] font-mono text-blue-400">
                <span>PROTOCOL // GAJA-AIP-V4</span>
                <span class="px-2 py-0.5 rounded bg-blue-500/20 border border-blue-500/30">75,000 TPS</span>
              </div>
              <div class="my-auto text-center space-y-3">
                <div class="w-20 h-20 mx-auto rounded-2xl bg-gradient-to-tr from-[#3e61ff] to-cyan-400 p-0.5 flex items-center justify-center shadow-xl">
                  <div class="w-full h-full bg-[#0c1222] rounded-[14px] flex items-center justify-center">
                    <svg class="w-10 h-10 text-[#3e61ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                  </div>
                </div>
                <div class="text-sm font-mono font-bold text-white">DISTRIBUTED SAGA ENGINE</div>
                <p class="text-xs text-blue-200/70 max-w-xs mx-auto">Non-blocking two-phase commit eliminates lock contention during festival surges</p>
              </div>
              <div class="text-[10px] font-mono text-gray-400 border-t border-white/10 pt-2 flex justify-between">
                <span>P99 SWITCH TRANSIT: 0.78ms</span>
                <span class="text-emerald-400">0.00% TECHNICAL DECLINE</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Block 2: Inverted - Left Graphic (Iconic Blue Smiley Orb as in Screenshot), Right Text -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 order-2 lg:order-1">
          <div class="unibase-card overflow-hidden shadow-lg p-2 bg-gradient-to-tr from-indigo-950 via-blue-900 to-slate-900">
            <!-- Exact reproduction of the iconic blue smiley cybernetic orb from the screenshot! -->
            <div class="w-full h-80 sm:h-96 rounded-xl relative overflow-hidden bg-[#0a0f1d] p-6 flex flex-col items-center justify-center text-center">
              <div class="relative w-40 h-40 rounded-full bg-gradient-to-b from-[#3e61ff] to-[#6366f1] p-1 flex items-center justify-center shadow-2xl shadow-blue-500/40 animate-pulse">
                <div class="w-full h-full rounded-full bg-gradient-to-tr from-[#2563eb] to-[#38bdf8] flex flex-col items-center justify-center relative">
                  <!-- Smiley Face Vector -->
                  <div class="flex items-center gap-6 mb-2">
                    <div class="w-3.5 h-3.5 rounded-full bg-white"></div>
                    <div class="w-3.5 h-3.5 rounded-full bg-white"></div>
                  </div>
                  <svg class="w-12 h-6 text-white" viewBox="0 0 48 24" fill="none">
                    <path d="M6 6C12 18 36 18 42 6" stroke="white" stroke-width="4.5" stroke-linecap="round"/>
                  </svg>
                </div>
              </div>
              <div class="mt-6 font-mono text-xs font-bold text-white tracking-wider">
                GAJALOGIC PAY // POST-QUANTUM SETTLEMENT
              </div>
              <p class="text-[11px] font-mono text-blue-300 mt-1">FIPS 204 ML-DSA Immutable Non-Repudiation</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 order-1 lg:order-2 space-y-4">
          <span class="text-xs font-mono font-bold text-[#3e61ff] uppercase tracking-wider block">
            SETTLEMENT ENGINE
          </span>
