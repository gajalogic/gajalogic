---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const executiveMetrics = [
  { value: '-64% TCO', label: 'Cumulative 5-Year Cost Reduction', sub: 'Eradicates per-TPS legacy licensing bloat' },
  { value: '75,000+ TPS', label: 'Elastic Switch Throughput', sub: 'Sub-millisecond P99 under festival peak' },
  { value: 'FIPS 203/204', label: 'Native Post-Quantum Envelopes', sub: 'ML-KEM & ML-DSA quantum immunity' },
  { value: '84.6% Offload', label: 'Core Banking (CBS) Shield', sub: 'Preserves Finacle, BaNCS & Flexcube IOPS' },
];

const strategicPillars = [
  {
    tag: 'Financial Disruption',
    title: 'The TCO Paradigm Shift',
    headline: 'Eradicate Legacy Volume-Penalizing Licensing',
    desc: 'Monolithic switches (Base24, Way4, Connex) were engineered in an era of thousands of daily transactions—not 16+ billion monthly UPI transfers. Traditional vendors tax Indian banks with escalating per-TPS license brackets and punitive annual maintenance contracts. Gajalogic replaces this extortionate model with an elastic cloud-native compute framework, slashing 5-year run-rate TCO by up to 64%.',
    points: [
      'Zero per-transaction licensing penalties as payment volume compounds',
      'Runs on modern Kubernetes and commodity bare-metal instead of proprietary mainframes',
      'Dynamic horizontally auto-scaling clusters that contract during off-peak hours to minimize cloud spend',
    ],
    stat: '-64%',
    statLabel: 'Total Cost of Ownership',
    link: `${base}/products`,
    linkText: 'Explore Switch Architecture',
  },
  {
    tag: 'National Security',
    title: 'The Quantum Horizon',
    headline: 'Neutralizing "Harvest Now, Decrypt Later"',
    desc: 'Adversarial state actors are aggressively intercepting and archiving encrypted financial telecommunications today. When Cryptanalytically Relevant Quantum Computers (CRQCs) arrive, Shor\'s algorithm will collapse RSA-2048 and ECC-256 in seconds—exposing customer bank accounts, historical balances, and trade secrets. Gajalogic secures in-flight payloads and ledgers with NIST-finalized FIPS 203/204 algorithms today.',
    points: [
      'Protects long-lived financial identifiers (account numbers, Aadhaar tokens, VPA maps) from retrospective decryption',
      'NIST FIPS 203 (ML-KEM) key encapsulation combined with FIPS 204 (ML-DSA) non-repudiation digital signatures',
      'In-switch hardware acceleration ensures zero throughput degradation or latency penalties',
    ],
    stat: 'FIPS 204',
    statLabel: 'NIST Quantum Standard',
    link: `${base}/compliance`,
    linkText: 'Read Quantum Threat Brief',
  },
  {
    tag: 'Operational Resilience',
    title: 'Hybrid Crypto-Agility',
    headline: 'Innovation Without Operational Disruption',
    desc: 'Transitioning national payment rails cannot involve downtime or ecosystem-wide flag days. Gajalogic\'s dual-rail cryptographic engine executes classical algorithms (RSA/ECC) and Post-Quantum Cryptography in parallel. Indian banks achieve instant compliance with upcoming RBI and GoI PQC Task Force mandates while maintaining 100% flawless backward compatibility with standard NPCI interfaces.',
    points: [
      'Dual-signature verification envelopes ensuring seamless backwards compatibility with legacy POS/ATMs',
      'Algorithm-agnostic microkernel allows swapping cryptographic suites via centralized policy, not code updates',
      'Compliant with Government of India 2027 Post-Quantum BFSI Migration Roadmaps',
    ],
    stat: '100%',
    statLabel: 'NPCI Interoperability',
    link: `${base}/platform`,
    linkText: 'Inspect Crypto-Agility Engine',
  },
];

const npciSuite = [
  {
    name: 'High-Throughput UPI Acquiring',
    badge: 'Merchant & PA-P Rail',
    slug: `${base}/products/upi-acquiring`,
    desc: 'Sub-millisecond distributed saga architecture and O(1) in-memory VPA lookups absorbing massive festival spikes with quantum-safe merchant settlement logs.',
    metric: '75,000+ TPS',
    metricLabel: 'Peak Capacity',
  },
  {
    name: 'UPI Issuing Switch',
    badge: 'Core Banking Shield',
    slug: `${base}/products/upi-issuing`,
    desc: 'In-memory balance virtualization offloading 84.6% of read pressure from legacy CBS databases while guarding customer metadata against quantum decryption.',
    metric: '84.6%',
    metricLabel: 'CBS Offload Ratio',
  },
  {
    name: 'TPAP Infrastructure',
    badge: 'Fintech Scale Engine',
    slug: `${base}/products/upi-tpap`,
    desc: 'High-velocity API middleware for consumer fintech apps. Decouples PQC key management to maintain an ultralight (< 180 KB) mobile client SDK footprint.',
    metric: '< 180 KB',
    metricLabel: 'Mobile SDK Size',
  },
  {
    name: 'RuPay Issuing & Acquiring',
    badge: 'Way4 / CMS Replacement',
    slug: `${base}/products/rupay-cards`,
    desc: 'Modern drop-in replacement for monolithic legacy card management systems. Native RuPay EMV, Card-on-File Tokenization, and automated NPCI DMS clearing.',
    metric: '62%',
    metricLabel: 'OPEX Reduction',
  },
  {
    name: 'NCMC & Transit Solutions',
    badge: 'Sub-300ms Gate Rail',
    slug: `${base}/products/ncmc-transit`,
    desc: 'Deterministic turnstile tap execution in < 240ms with zero-leakage offline stored value ledgers and memory-optimized smart card silicon R&D.',
    metric: '< 240 ms',
    metricLabel: 'Turnstile Tap SLA',
  },
];

const tcoEconomics = [
  {
    category: 'Licensing Structure',
    legacy: 'Tiered per-TPS penalty licensing. Costs escalate exponentially as national digital payment volumes surge.',
    gajalogic: 'Transparent, compute-aligned core model. Zero per-transaction penalty licensing. Uncapped transaction volume.',
  },
  {
    category: 'Hardware & Infrastructure',
    legacy: 'Proprietary mainframe blades and heavy on-premise hardware arrays requiring 32+ physical chassis to handle 25k TPS.',
    gajalogic: 'Kubernetes-native elastic nodes running on commodity x86/ARM or private cloud. 6 nodes handle 75k+ TPS.',
  },
  {
    category: 'Cryptographic Upgrade Cost',
    legacy: 'Complete rip-and-replace of legacy HSM infrastructure required to support emerging post-quantum algorithms.',
    gajalogic: 'Native software-defined cryptographic sidecars and hybrid PCIe accelerators upgradable via remote firmware.',
  },
  {
    category: 'Core Banking System (CBS) Wear',
    legacy: '100% of balance checks hit core banking databases, forcing expensive annual database licensing and core upgrades.',
    gajalogic: 'In-memory balance cache intercepts 84.6% of queries, extending CBS system lifespan by 5-7 years.',
  },
];

const hndlTimeline = [
  {
    period: 'Present Day (2024 - 2026)',
    phase: 'Passive Signal Interception',
    threat: 'Adversary state intelligence networks continuously harvest and archive encrypted financial transactions, settlement journals, and bank account mappings across public and leased telecommunication backbones.',
    defense: 'Gajalogic wraps every payload in NIST FIPS 203 (ML-KEM) lattice envelopes today, neutralizing retrospective decryption permanently.',
  },
  {
    period: 'Transition Window (2026 - 2028)',
    phase: 'Regulatory PQC Mandates',
    threat: 'The Government of India PQC Task Force and RBI Q-SAFE committees mandate post-quantum compliance for Tier-1 banks. Legacy switches face crippling regulatory compliance halts.',
    defense: 'Gajalogic\'s crypto-agile hybrid engine enables instant algorithm switching without service interruption or consumer app recertification.',
  },
  {
    period: 'The Quantum Horizon ("Q-Day")',
    phase: 'CRQC Cryptanalytic Breakthrough',
    threat: 'Cryptanalytically Relevant Quantum Computers run Shor\'s algorithm, rendering RSA-2048 and ECC-256 completely obsolete in minutes. Harvested historical financial ledgers are unmasked.',
    defense: 'Gajalogic-secured historical archives remain mathematically invulnerable under worst-case quantum cryptanalysis scenarios.',
  },
];
---

<Layout
  title="Gajalogic | Quantum-Safe, NPCI-Native Payment Infrastructure"
  description="Gajalogic delivers high-throughput UPI and IMPS switches embedded with Post-Quantum Cryptography (PQC). Eradicate legacy licensing bloat while neutralizing the Harvest Now, Decrypt Later threat."
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 lg:pt-28 lg:pb-32 overflow-hidden">
    <!-- Ambient Unibase Glow Accents -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[450px] bg-gradient-to-tr from-sky-500/12 via-indigo-500/10 to-purple-500/12 blur-[140px] rounded-full"></div>
      <div class="absolute -top-32 left-10 w-96 h-96 bg-sky-600/10 blur-[110px] rounded-full"></div>
      <div class="absolute top-1/2 right-5 w-80 h-80 bg-purple-600/10 blur-[120px] rounded-full"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto">
        
        <!-- Strategic Regulatory Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium bg-slate-900/90 border border-slate-700/80 text-slate-300 mb-8 shadow-inner hover:border-sky-500/50 transition-colors">
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-gradient-to-r from-sky-500 to-indigo-500 text-slate-950 font-mono">
            National Security
          </span>
          <span>Aligned with RBI Q-SAFE & GoI Post-Quantum Task Force 2027 Mandates</span>
          <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>

        <!-- Main C-Suite Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] mb-6">
          Quantum-Safe, NPCI-Native Payment Infrastructure. <span class="text-gradient">Built for India.</span>
        </h1>

        <!-- Sub-headline -->
        <p class="text-lg sm:text-xl text-slate-300 font-light leading-relaxed max-w-3xl mx-auto mb-10">
          Gajalogic delivers high-throughput UPI and IMPS switches embedded with Post-Quantum Cryptography (PQC). Eradicate legacy licensing bloat while neutralizing the "Harvest Now, Decrypt Later" threat.
        </p>

        <!-- Primary & Secondary CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
          <a
            href={`${base}/platform`}
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-slate-950 bg-gradient-to-r from-sky-400 via-sky-300 to-indigo-300 hover:from-sky-300 hover:to-indigo-200 rounded-xl shadow-lg shadow-sky-500/25 transition-all hover:scale-105"
          >
            View the Architecture
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a
            href={`${base}/developers`}
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-slate-900/90 hover:bg-slate-800 border border-slate-700 rounded-xl transition-all font-mono text-sm"
          >
            Access the PQC Migration Sandbox
          </a>
        </div>

      </div>

      <!-- Real-Time Cryptographic & Switch Telemetry Console -->
      <div class="max-w-4xl mx-auto unibase-card border border-white/10 shadow-2xl overflow-hidden">
        <div class="flex items-center justify-between px-4 py-3 bg-slate-950 border-b border-slate-800">
          <div class="flex items-center space-x-2">
            <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            <span class="ml-2 text-xs font-mono text-slate-400">gajalogic-core-switch-01:~# telemetry --audit pqc-hybrid</span>
          </div>
          <span class="text-[11px] font-mono text-emerald-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            PQC ENCLAVE ACTIVE // 75,420 TPS
          </span>
        </div>

        <div class="p-6 bg-slate-950/95 font-mono text-xs sm:text-sm text-slate-300 space-y-3 overflow-x-auto">
          <div class="text-slate-500">// Real-time dual-rail cryptographic verification & CBS insulation</div>
          <p><span class="text-sky-400">$</span> gajactl status --quantum-enclave --rail upi-v2</p>
          <div class="text-emerald-400 pl-4">✓ Classical Rail: RSA-2048 / SHA-256 (100% NPCI Interoperable)</div>
          <div class="text-purple-400 pl-4">✓ Post-Quantum Rail: NIST FIPS 203 ML-KEM-1024 + FIPS 204 ML-DSA-65</div>
          <div class="text-sky-300 pl-4">✓ In-Memory O(1) VPA Table: 48.2M records | Lookup latency: 138 µs</div>
          <div class="text-emerald-400 pl-4">✓ CBS Protection Shield: 84.6% non-financial queries intercepted</div>
          <p><span class="text-sky-400">$</span> gajactl audit hndl-defense --window "historical-at-rest"</p>
          <div class="text-slate-400 pl-4">↳ In-flight session keys: Ephemerally rotated every 60s via quantum RNG</div>
          <div class="text-emerald-400 pl-4">↳ Harvest Now, Decrypt Later Vulnerability: 0.00% (Mathematical Lattice Bound)</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Executive Impact Metrics Strip -->
  <section class="border-y border-white/10 bg-slate-950/70 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {executiveMetrics.map((m) => (
          <div class="text-center sm:text-left">
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-white tracking-tight">
              {m.value}
            </div>
            <div class="text-sm font-semibold text-slate-200 mt-1">{m.label}</div>
            <div class="text-xs text-sky-400 font-mono mt-0.5">{m.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Strategic Imperative (Why Gajalogic?) -->
  <section class="py-20 lg:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider text-sky-400 border-sky-500/30 bg-sky-950/30 mb-2 inline-block">
        Executive Strategic Imperative
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mt-2">
        Why Gajalogic? The Dual Imperative
      </h2>
      <p class="text-slate-400 mt-3 text-base sm:text-lg font-light leading-relaxed">
        Banking C-suites face two existential pressures: unsustainable licensing taxes as transaction volumes explode, and the imminent collapse of classical encryption.
      </p>
    </div>

    <!-- 3 Core Strategic Pillars -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {strategicPillars.map((pillar) => (
        <div class="unibase-card p-8 flex flex-col justify-between border border-white/10 relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-sky-500/0 group-hover:via-sky-400/60 to-transparent transition-all duration-500"></div>

          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="mono-tag font-bold uppercase tracking-wider">
                {pillar.tag}
              </span>
              <div class="text-right">
                <div class="text-xl font-extrabold font-mono text-white">{pillar.stat}</div>
                <div class="text-[10px] font-mono text-slate-400 uppercase">{pillar.statLabel}</div>
              </div>
            </div>

            <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-sky-400 mb-1">
              {pillar.title}
            </h3>

            <h4 class="text-2xl font-bold text-white mb-4 group-hover:text-sky-300 transition-colors">
              {pillar.headline}
            </h4>

            <p class="text-sm text-slate-300 leading-relaxed mb-6 font-light">
              {pillar.desc}
            </p>

            <ul class="space-y-2.5 mb-8">
              {pillar.points.map((pt) => (
                <li class="flex items-start text-xs sm:text-sm text-slate-300">
                  <svg class="w-4 h-4 text-sky-400 mr-2.5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-5 border-t border-slate-800 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-500">Strategic Priority</span>
            <a
              href={pillar.link}
              class="inline-flex items-center text-sm font-semibold text-sky-400 group-hover:text-sky-300 group-hover:translate-x-1 transition-all"
            >
              <span>{pillar.linkText}</span>
              <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Deep Dive 1: The TCO Paradigm Shift (BCG Sizing Analysis) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider text-emerald-400 border-emerald-500/30 bg-emerald-950/30 mb-2 inline-block">
        Financial Architecture
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-2">
        The TCO Paradigm Shift: Eradicating Legacy Switch Bloat
      </h2>
      <p class="text-slate-400 mt-3 text-base">
        A financial audit illustrating how legacy payment switches impose punitive volume taxes on Indian banks, contrasted against Gajalogic's elastic cloud-native infrastructure.
      </p>
    </div>

    <!-- TCO Economic Matrix -->
    <div class="unibase-card overflow-hidden border border-white/10 shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900/90 text-xs font-mono uppercase text-slate-400 border-b border-slate-800">
            <tr>
              <th class="px-6 py-4 w-1/4">Cost Driver</th>
              <th class="px-6 py-4 w-3/8 text-rose-400">Monolithic Legacy Switches (Way4 / Base24 / FIS)</th>
              <th class="px-6 py-4 w-3/8 text-emerald-400 font-bold">Gajalogic Cloud-Native Stack</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-xs sm:text-sm">
            {tcoEconomics.map((row) => (
              <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="px-6 py-4 font-mono font-semibold text-white bg-slate-950/40">
                  {row.category}
                </td>
                <td class="px-6 py-4 text-slate-400 leading-relaxed border-r border-slate-800">
                  {row.legacy}
                </td>
                <td class="px-6 py-4 text-slate-200 leading-relaxed bg-emerald-950/10">
                  {row.gajalogic}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Deep Dive 2: Deconstructing "Harvest Now, Decrypt Later" (HNDL) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider text-purple-400 border-purple-500/30 bg-purple-950/30 mb-2 inline-block">
        National Cryptographic Threat
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-2">
        Neutralizing "Harvest Now, Decrypt Later"
      </h2>
      <p class="text-slate-400 mt-3 text-base">
        Why waiting for Q-Day is a catastrophic strategic error: your bank\'s transaction records are being exfiltrated today.
      </p>
    </div>

    <!-- HNDL Threat Evolution Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {hndlTimeline.map((item, idx) => (
        <div class="unibase-card p-8 flex flex-col justify-between border border-white/10 relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-purple-500/0 hover:via-purple-400/60 to-transparent transition-all duration-500"></div>
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-purple-400 uppercase tracking-wider">
                Phase 0{idx + 1}
              </span>
              <span class="text-[11px] font-mono text-slate-400">{item.period}</span>
            </div>

            <h3 class="text-xl font-bold text-white mb-3">
              {item.phase}
            </h3>

            <div class="p-3 bg-rose-950/20 border border-rose-500/20 rounded-xl mb-4 text-xs text-rose-200 leading-relaxed font-light">
              <strong class="font-semibold text-rose-400 block mb-1 font-mono uppercase text-[10px]">Active Threat Profile</strong>
              {item.threat}
            </div>

            <div class="p-3 bg-slate-900/90 border border-slate-800 rounded-xl text-xs text-slate-300 leading-relaxed font-light">
              <strong class="font-semibold text-emerald-400 block mb-1 font-mono uppercase text-[10px]">Gajalogic Countermeasure</strong>
              {item.defense}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- NPCI Product Suite Showcase -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/5 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider text-sky-400 border-sky-500/30 bg-sky-950/30 mb-2 inline-block">
        Integrated Switch Portfolio
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-2">
        The NPCI Product Suite
      </h2>
      <p class="text-slate-400 mt-3 text-base">
        Modular, high-throughput payment switches designed specifically for India\'s national payment rails.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {npciSuite.map((prod) => (
        <a
          href={prod.slug}
          class="unibase-card p-6 flex flex-col justify-between group transition-all"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="mono-tag text-[10px] uppercase font-bold text-sky-400">
                {prod.badge}
              </span>
              <div class="text-right">
                <div class="text-base font-bold font-mono text-white">{prod.metric}</div>
                <div class="text-[9px] font-mono text-slate-500 uppercase">{prod.metricLabel}</div>
              </div>
            </div>

            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-sky-300 transition-colors">
              {prod.name}
            </h3>

            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 font-light">
              {prod.desc}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-semibold text-sky-400 group-hover:text-sky-300">
            <span>Explore Technical Spec</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
      <a
        href={`${base}/products`}
        class="unibase-card p-6 flex flex-col items-center justify-center text-center group border-dashed hover:border-sky-500/40"
      >
        <div class="w-12 h-12 rounded-xl bg-slate-800/80 border border-slate-700 flex items-center justify-center text-sky-400 group-hover:scale-110 transition-transform mb-3">
