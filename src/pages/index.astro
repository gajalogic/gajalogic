---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const metrics = [
  { value: '380 TFLOPS', label: 'Dense FP8 Compute / Card', change: '+45% gen-over-gen' },
  { value: '0.84 ms', label: 'P99 Edge Latency', change: 'Sub-millisecond guarantees' },
  { value: '100%', label: 'Hardware Enclave Isolation', change: 'Zero shared cache lines' },
  { value: '72W', label: 'Ultra-low TDP Profile', change: 'Passive cooling ready' },
];

const pillars = [
  {
    title: 'Enterprise Hardware',
    desc: 'Custom-designed PCIe 5.0 accelerator blades and edge modules engineered for sustained AI & vector tensor pipelines.',
    href: `${base}/hardware`,
    tag: 'Silicon & Modules',
    icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  },
  {
    title: 'Distributed Platform',
    desc: 'Federated orchestration runtime providing automatic model sharding, zero-copy memory fabrics, and dynamic failover.',
    href: `${base}/platform`,
    tag: 'Cloud & Mesh',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
  {
    title: 'Flagship Products',
    desc: 'Turnkey appliance servers, Logic-OS cluster management, and hybrid cloud inference gateways ready for instant scale.',
    href: `${base}/products`,
    tag: 'Turnkey Suite',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
  {
    title: 'Developer First API',
    desc: 'Unified SDKs in Rust, Python, Go, and C++ with full compatibility for PyTorch, ONNX, and TensorRT primitives.',
    href: `${base}/developers`,
    tag: 'Tooling & SDK',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
  {
    title: 'Sovereign Compliance',
    desc: 'Certified to SOC 2 Type II, ISO 27001, HIPAA, and FIPS 140-3 Level 4 standards for defense, finance, and healthcare.',
    href: `${base}/compliance`,
    tag: 'Security & Trust',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Company & Vision',
    desc: 'Building sovereign, resilient computing infrastructure with an unyielding commitment to engineering excellence.',
    href: `${base}/company`,
    tag: 'Our Story',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  },
];
---

<Layout
  title="GajaLogic | Sovereign Compute & High-Performance Hardware"
  description="GajaLogic provides enterprise-grade AI accelerators, distributed cluster platforms, and sovereign hardware infrastructure engineered for extreme performance."
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 lg:pt-24 lg:pb-32 overflow-hidden">
    <!-- Background gradients -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-sky-500/15 via-indigo-500/10 to-purple-500/15 blur-[120px] rounded-full"></div>
      <div class="absolute -top-32 left-10 w-96 h-96 bg-sky-600/10 blur-[100px] rounded-full"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto">
        
        <!-- Announcement Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-slate-900 border border-slate-700/80 text-slate-300 mb-8 shadow-inner hover:border-sky-500/50 transition-colors">
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-gradient-to-r from-sky-500 to-indigo-500 text-slate-950">New</span>
          <span>Introducing GajaLogic G4 PCIe Blades with FIPS 140-3 Root-of-Trust</span>
          <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
          Sovereign Compute & Distributed <span class="text-gradient">Intelligence</span> at Scale
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-300 font-light leading-relaxed max-w-2xl mx-auto mb-10">
          GajaLogic unites ultra-dense hardware accelerators, an autonomous distributed OS, and zero-trust verification into a unified infrastructure foundation.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
          <a
            href={`${base}/products`}
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-slate-950 bg-gradient-to-r from-sky-400 via-sky-300 to-indigo-300 hover:from-sky-300 hover:to-indigo-200 rounded-xl shadow-lg shadow-sky-500/25 transition-all hover:scale-105"
          >
            Explore Product Suite
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a
            href={`${base}/hardware`}
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-white bg-slate-900/90 hover:bg-slate-800 border border-slate-700 rounded-xl transition-all"
          >
            Silicon & Hardware Specs
          </a>
        </div>

      </div>

      <!-- Interactive Terminal / Telemetry Preview -->
      <div class="max-w-4xl mx-auto glass-panel rounded-2xl border border-white/10 shadow-2xl overflow-hidden">
        <!-- Terminal Header -->
        <div class="flex items-center justify-between px-4 py-3 bg-slate-950 border-b border-slate-800">
          <div class="flex items-center space-x-2">
            <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            <span class="ml-2 text-xs font-mono text-slate-400">gajalogic-node-01:~# telemetry-monitor</span>
          </div>
          <span class="text-[11px] font-mono text-emerald-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            CLUSTER ACTIVE (48 BLADES)
          </span>
        </div>

        <!-- Terminal Body -->
        <div class="p-6 bg-slate-950/90 font-mono text-xs sm:text-sm text-slate-300 space-y-3 overflow-x-auto">
          <div class="text-slate-500">// Initialize zero-copy distributed model partition across GajaLogic PCIe nodes</div>
          <p><span class="text-sky-400">$</span> gajactl cluster init --topology torus-3d --enclave strict</p>
          <div class="text-emerald-400 pl-4">✓ Topology established: 48 nodes / 384 Logic-Core TPU units detected</div>
          <div class="text-emerald-400 pl-4">✓ Hardware Root-of-Trust verified: FIPS 140-3 L4 Secure Enclave active</div>
          <div class="text-emerald-400 pl-4">✓ Memory fabric bandwidth: 4.8 TB/s bidirectional aggregate</div>
          <p><span class="text-sky-400">$</span> gajactl deploy --workload deepseek-r1-70b --batch-latency max-2ms</p>
          <div class="text-slate-400 pl-4">↳ Model distributed over 8 blades (64GB HBM3e allocated per card)</div>
          <div class="text-sky-300 pl-4">↳ Serving live requests on port 8443 | TTFT: 14.2ms | Tokens/s: 184.6 | P99: 0.84ms</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Metrics Grid -->
  <section class="border-y border-white/10 bg-slate-950/60 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {metrics.map((m) => (
          <div class="text-center sm:text-left">
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-white tracking-tight">
              {m.value}
            </div>
            <div class="text-sm font-semibold text-slate-200 mt-1">{m.label}</div>
            <div class="text-xs text-sky-400 font-mono mt-0.5">{m.change}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Pillars Grid -->
  <section class="py-20 lg:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs sm:text-sm font-mono uppercase tracking-widest text-sky-400 mb-3">Complete Architecture</h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Engineered for Mission-Critical Compute
      </p>
      <p class="text-slate-400 mt-4 text-base sm:text-lg">
        Explore each pillar of the GajaLogic sovereign computing stack, built from custom silicon all the way to high-level developer primitives.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {pillars.map((pillar) => (
        <a
          href={pillar.href}
          class="glass-panel glass-panel-hover rounded-2xl p-7 flex flex-col justify-between group transition-all"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-xl bg-slate-800/80 border border-slate-700/80 flex items-center justify-center text-sky-400 group-hover:text-sky-300 group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={pillar.icon} />
                </svg>
              </div>
              <span class="text-[11px] font-mono uppercase px-2.5 py-1 rounded-md bg-slate-800 text-sky-400 border border-slate-700">
                {pillar.tag}
              </span>
            </div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-sky-300 transition-colors">
              {pillar.title}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">
              {pillar.desc}
            </p>
          </div>
          <div class="flex items-center text-sm font-semibold text-sky-400 group-hover:text-sky-300 pt-4 border-t border-slate-800/80">
            <span>Explore {pillar.title}</span>
            <svg class="w-4 h-4 ml-1.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Call to action -->
  <CtaBanner />
</Layout>
