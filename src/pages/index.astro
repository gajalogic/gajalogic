---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const metrics = [
  { value: '75,000+ TPS', label: 'Elastic Switch Capacity', change: 'Tested under peak festival load' },
  { value: '< 1.0 ms', label: 'In-Switch Latency (P99)', change: 'Zero garbage collection jitter' },
  { value: '-62% TCO', label: 'Cost Reduction vs Legacy', change: 'Zero per-TPS licensing penalty' },
  { value: 'FIPS 203/204', label: 'Post-Quantum Native', change: 'NIST ML-KEM & ML-DSA' },
];

const pillars = [
  {
    title: 'NPCI Product Suite',
    desc: 'Turnkey high-throughput switches for UPI Acquiring, UPI Issuing, TPAP Infrastructure, RuPay Cards, and NCMC Transit.',
    href: `${base}/products`,
    tag: 'Payment Rails',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
  {
    title: 'Distributed Platform',
    desc: 'Federated microsecond saga runtime providing in-memory O(1) VPA lookups, CBS decoupling, and automated failover.',
    href: `${base}/platform`,
    tag: 'Switch Architecture',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
  {
    title: 'Sovereign Hardware',
    desc: 'PCIe 5.0 cryptographic accelerator blades and tamper-resilient edge modules with physical root-of-trust.',
    href: `${base}/hardware`,
    tag: 'Hardware HSM',
    icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  },
  {
    title: 'Developer First API',
    desc: 'Unified SDKs in Rust, Python, Go, and C++ with full compatibility for ISO 8583, AS 2805, and ISO 20022 messages.',
    href: `${base}/developers`,
    tag: 'Tooling & SDK',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
  {
    title: 'Sovereign Compliance',
    desc: 'Certified to SOC 2 Type II, ISO 27001, PCI-DSS v4.0, and FIPS 140-3 Level 4 for Tier-1 Banks and Central Infrastructures.',
    href: `${base}/compliance`,
    tag: 'Security & Trust',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Company & Vision',
    desc: 'Building sovereign, resilient national computing and payment infrastructure with an unyielding commitment to engineering excellence.',
    href: `${base}/company`,
    tag: 'Our Story',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  },
];
---

<Layout
  title="Gajalogic | Sovereign Payment Rails & High-Throughput Switches"
  description="Gajalogic delivers next-generation payment switches for UPI, RuPay, and NCMC transit with sub-millisecond sagas and native post-quantum security."
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 lg:pt-24 lg:pb-32 overflow-hidden">
    <!-- Background ambient gradients -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-sky-500/15 via-indigo-500/10 to-purple-500/15 blur-[120px] rounded-full"></div>
      <div class="absolute -top-32 left-10 w-96 h-96 bg-sky-600/10 blur-[100px] rounded-full"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto">
        
        <!-- Announcement Pill -->
        <a href={`${base}/products`} class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium bg-slate-900 border border-slate-700/80 text-slate-300 mb-8 shadow-inner hover:border-sky-500/50 transition-colors">
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-gradient-to-r from-sky-500 to-indigo-500 text-slate-950 font-mono">NPCI Suite</span>
          <span>Next-Gen UPI Acquiring, Issuing & RuPay Card Switches Released</span>
          <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
          Sovereign Payment Switches & <span class="text-gradient">Post-Quantum</span> National Rails
        </h1>

        <!-- Subtitle (BCG Tone) -->
        <p class="text-lg sm:text-xl text-slate-300 font-light leading-relaxed max-w-2xl mx-auto mb-10">
          Gajalogic modernizes mission-critical payment rails for Tier-1 banks, payment aggregators, and fintechs. Eliminate legacy licensing bloat while securing trillions in transaction volume with post-quantum cryptography.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
          <a
            href={`${base}/products`}
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-slate-950 bg-gradient-to-r from-sky-400 via-sky-300 to-indigo-300 hover:from-sky-300 hover:to-indigo-200 rounded-xl shadow-lg shadow-sky-500/25 transition-all hover:scale-105"
          >
            Explore NPCI Product Suite
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a
            href={`${base}/products/upi-acquiring`}
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-white bg-slate-900/90 hover:bg-slate-800 border border-slate-700 rounded-xl transition-all font-mono text-sm"
          >
            UPI Acquiring Architecture
          </a>
        </div>

      </div>

      <!-- Interactive Switch Telemetry Terminal -->
      <div class="max-w-4xl mx-auto unibase-card border border-white/10 shadow-2xl overflow-hidden">
        <!-- Terminal Header -->
        <div class="flex items-center justify-between px-4 py-3 bg-slate-950 border-b border-slate-800">
          <div class="flex items-center space-x-2">
            <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            <span class="ml-2 text-xs font-mono text-slate-400">gajalogic-npci-switch-node-01:~# telemetry</span>
          </div>
          <span class="text-[11px] font-mono text-emerald-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            ACTIVE SWITCH FABRIC (75,420 TPS)
          </span>
        </div>

        <!-- Terminal Body -->
        <div class="p-6 bg-slate-950/90 font-mono text-xs sm:text-sm text-slate-300 space-y-3 overflow-x-auto">
          <div class="text-slate-500">// Real-time UPI Acquiring & Issuing telemetry during simulated festive peak</div>
          <p><span class="text-sky-400">$</span> gajactl switch status --rail upi-v2 --pqc-enclave active</p>
          <div class="text-emerald-400 pl-4">✓ In-Memory O(1) VPA Cache: 42,000,000 VPAs mapped | Lookup latency: 140 µs</div>
          <div class="text-emerald-400 pl-4">✓ CBS Protection Shield: 84.6% balance queries resolved in-memory (Finacle/BaNCS saved)</div>
          <div class="text-emerald-400 pl-4">✓ Quantum Cryptographic Envelope: NIST FIPS 203 (ML-KEM) active on all remitter tunnels</div>
          <p><span class="text-sky-400">$</span> gajactl benchmark --concurrency 50000 --duration 60s</p>
          <div class="text-slate-400 pl-4">↳ Ingress rate: 75,180 req/sec | Success rate: 99.999% | Technical Declines: 0.00%</div>
          <div class="text-sky-300 pl-4">↳ Internal Switch P99 Latency: 0.78 ms | Merchant Settlement Log: 100% PQC Sealed</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Metrics Grid -->
  <section class="border-y border-white/10 bg-slate-950/60 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {metrics.map((m) => (
          <div class="text-center sm:text-left">
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-white tracking-tight">
              {m.value}
            </div>
            <div class="text-sm font-semibold text-slate-200 mt-1">{m.label}</div>
            <div class="text-xs text-sky-400 font-mono mt-0.5">{m.change}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Pillars Grid -->
  <section class="py-20 lg:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-mono uppercase tracking-widest text-sky-400 mb-3">Enterprise Stack</h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Engineered for High-Throughput Financial Rails
      </p>
      <p class="text-slate-400 mt-4 text-base sm:text-lg">
        Explore each pillar of the Gajalogic platform, built from custom hardware enclaves to sovereign payment switch micro-sagas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {pillars.map((pillar) => (
        <a
          href={pillar.href}
          class="unibase-card p-7 flex flex-col justify-between group transition-all"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-xl bg-slate-800/80 border border-slate-700/80 flex items-center justify-center text-sky-400 group-hover:text-sky-300 group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={pillar.icon} />
                </svg>
              </div>
              <span class="mono-tag uppercase">
                {pillar.tag}
              </span>
            </div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-sky-300 transition-colors">
              {pillar.title}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-6 font-light">
              {pillar.desc}
            </p>
          </div>
          <div class="flex items-center text-sm font-semibold text-sky-400 group-hover:text-sky-300 pt-4 border-t border-slate-800/80">
            <span>Explore {pillar.title}</span>
            <svg class="w-4 h-4 ml-1.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Call to action -->
  <CtaBanner
    title="Ready to Modernize Your Bank or Payment Aggregator Switch?"
    subtitle="Our payment infrastructure architects can model your transaction curves and run a live 50,000 synthetic TPS stress test on your VPC."
    buttonText="Schedule Technical Briefing"
    secondaryText="Explore NPCI Product Suite"
    secondaryHref={`${base}/products`}
  />
</Layout>
