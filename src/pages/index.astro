    </div>
  </section>

  <!-- Industrial Engineering Call-to-Action Section -->
  <section class="py-16 lg:py-24 bg-[#030303]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border border-white/10 p-8 sm:p-12 bg-[#080808] flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div class="max-w-2xl space-y-2">
          <div class="text-[10px] font-mono text-neutral-400 uppercase tracking-widest">
