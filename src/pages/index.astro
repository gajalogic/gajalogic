---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const systemMetrics = [
  { id: 'PAR-01', label: 'THROUGHPUT CAPACITY', value: '75,000+ TPS', note: 'Line-rate elastic scaling under simulated festive load' },
  { id: 'PAR-02', label: 'IN-SWITCH LATENCY', value: '< 1.0 ms (P99)', note: 'Deterministic micro-saga; zero GC thread pauses' },
  { id: 'PAR-03', label: 'TCO DELTA vs LEGACY', value: '-64% 5-YR RUN', note: 'Zero per-TPS licensing penalty brackets' },
  { id: 'PAR-04', label: 'CRYPTOGRAPHIC ENCLAVE', value: 'FIPS 203 / 204', note: 'Native NIST ML-KEM-1024 & ML-DSA-65 algorithms' },
];

const tcoParameters = [
  {
    parameter: 'Licensing Model',
    legacy: 'Tiered per-TPS penalty fees; annual license spikes reaching $2.4M+ during festive surges.',
    gajalogic: 'Compute-aligned capacity core. Zero per-transaction penalty fees. Uncapped throughput.',
    delta: '-64% Net OPEX',
  },
  {
    parameter: 'Hardware Footprint',
    legacy: 'Proprietary mainframe chassis or 32+ physical x86 bare-metal appliances for 25k TPS.',
    gajalogic: 'Containerized Kubernetes microkernel; 6 nodes sustain 75,000+ TPS at <65% CPU saturation.',
    delta: '81% Rack Reduction',
  },
  {
    parameter: 'CBS Database Wear',
    legacy: '100% of balance checks and VPA lookups hit primary core banking SQL databases directly.',
    gajalogic: 'In-memory shadow ledger intercepts 84.6% of queries before touching Finacle/BaNCS.',
    delta: '84.6% CBS Offload',
  },
  {
    parameter: 'Cryptographic Upgrade Pathway',
    legacy: 'Hardcoded RSA-2048 HSM arrays requiring total physical hardware replacement to support PQC.',
    gajalogic: 'Modular crypto engine with hybrid classical/PQC abstraction sidecar upgradeable via firmware.',
    delta: 'Zero-Hardware Flag Day',
  },
  {
    parameter: 'Technical Decline (TD) Rate',
    legacy: 'Averages 2.4% during evening checkout peaks due to database lock queues and thread stalls.',
    gajalogic: 'Reduced to <0.04% with sub-second deterministic fallback buffers and synthetic health probes.',
    delta: '98.3% TD Reduction',
  },
];

const hndlAttackVectors = [
  {
    phase: 'VECTOR 01: PASSIVE INTERCEPTION',
    timeframe: 'PRESENT DAY (2024 - 2026)',
    mechanism: 'Adversary state intelligence sensors continuously tap public telecommunication backbones and leased banking WAN lines. In-flight UPI, IMPS, and ISO 8583 payloads are archived in encrypted data vaults.',
    countermeasure: 'Gajalogic encapsulates every session in NIST FIPS 203 (ML-KEM) lattice envelopes at line rate, ensuring archived packets are mathematically intractable to decrypt.',
    state: 'ACTIVE INTERCEPTION',
  },
  {
    phase: 'VECTOR 02: MANDATORY PQC TRANSITION',
    timeframe: 'REGULATORY MILESTONE (2026 - 2027)',
    mechanism: 'Government of India PQC Task Force and RBI Q-SAFE committees enforce post-quantum migration deadlines for Indian BFSI. Legacy switches face immediate compliance suspension.',
    countermeasure: 'Dual-signature hybrid envelopes (RSA-2048 + ML-DSA-65) execute simultaneously, providing immediate regulatory compliance with zero downstream NPCI disruption.',
    state: 'COMPLIANCE MANDATE',
  },
  {
    phase: 'VECTOR 03: QUANTUM CRYPTANALYTIC BREAKTHROUGH',
    timeframe: 'THE QUANTUM HORIZON (Q-DAY)',
    mechanism: 'Cryptanalytically Relevant Quantum Computers (CRQCs) execute Shor\'s algorithm, solving the Discrete Logarithm and Integer Factorization problems in minutes. RSA and ECC collapse.',
    countermeasure: 'Historical ledgers and customer metadata protected by Gajalogic\'s lattice-based cryptography remain invulnerable against worst-case quantum attacks.',
    state: 'PERMANENT IMMUNITY',
  },
];

const npciProducts = [
  {
    code: 'PRD-01',
    name: 'High-Throughput UPI Acquiring',
    slug: `${base}/products/upi-acquiring`,
    target: 'Product Heads, Payment Aggregators (PA-Ps), Tier-1 Acquirer Banks',
    specSummary: 'Sub-millisecond distributed saga architecture, in-memory O(1) VPA lookups (<140µs), and quantum-safe merchant settlement logs.',
    throughput: '75,000+ TPS',
    latency: '0.78 ms (P99)',
  },
  {
    code: 'PRD-02',
    name: 'UPI Issuing Switch',
    slug: `${base}/products/upi-issuing`,
    target: 'Bank CTOs, Core Banking System (CBS) Leads',
    specSummary: 'In-memory balance virtualization offloading 84.6% of CBS query pressure; FIPS 203 ML-KEM protection for account holder metadata.',
    throughput: '50,000+ TPS',
    latency: '< 1.1 ms',
  },
  {
    code: 'PRD-03',
    name: 'TPAP Infrastructure',
    slug: `${base}/products/upi-tpap`,
    target: 'Fintech Integration Leads, Consumer App Architects',
    specSummary: 'Scalable multi-bank API infrastructure for Third-Party Application Providers with decoupled PQC key management (<180 KB client SDK).',
    throughput: '60,000+ TPS',
    latency: '< 1.4 ms',
  },
  {
    code: 'PRD-04',
    name: 'RuPay Issuing & Acquiring',
    slug: `${base}/products/rupay-cards`,
    target: 'Card Operations Heads, Banking Procurement',
    specSummary: 'Drop-in replacement for legacy card management systems (Way4, FIS); native RuPay EMV, CoFT tokenization, and NPCI DMS automation.',
    throughput: '35,000+ TPS',
    latency: '1.4 ms',
  },
  {
    code: 'PRD-05',
    name: 'NCMC & Transit Solutions',
    slug: `${base}/products/ncmc-transit`,
    target: 'Transit Authorities, Metro Rail Corporations, Smart Cities',
    specSummary: 'High-velocity Mass Transit Transactions (MTT) in <240ms; zero-leakage offline stored value ledgers and sub-48KB PQC smart card silicon.',
    throughput: '45+ gates/min',
    latency: '< 240 ms',
  },
];
---

<Layout
  title="Gajalogic // Quantum-Safe, NPCI-Native Payment Infrastructure"
  description="High-throughput UPI and IMPS switches embedded with Post-Quantum Cryptography (PQC). Eradicating legacy licensing bloat while neutralizing the Harvest Now, Decrypt Later threat."
>
  <!-- Technical Specification Header Frame -->
  <div class="border-b border-white/10 bg-[#060606] text-neutral-400 font-mono text-[11px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <span class="text-white font-semibold">GAJALOGIC SYSTEMS ARCHITECTURE</span>
        <span class="hidden sm:inline text-neutral-600">//</span>
        <span class="hidden sm:inline">NATIONAL PAYMENT SWITCH SPECIFICATION</span>
      </div>
      <div class="flex items-center gap-4 text-[10px]">
        <span>SPEC-ID: UPI-PQC-2026</span>
        <span class="text-neutral-600">|</span>
        <span>REV: 4.2.0</span>
        <span class="text-neutral-600">|</span>
        <span class="text-neutral-300 font-semibold">CLASSIFICATION: PUBLIC TECHNICAL BRIEFING</span>
      </div>
    </div>
  </div>

  <!-- Primary Engineering Hero -->
  <section class="border-b border-white/10 py-16 lg:py-24 bg-[#030303]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Left-Aligned Technical Metadata Eyebrow -->
      <div class="mb-6 flex flex-wrap items-center gap-3 font-mono text-xs">
        <span class="tech-tag tech-tag-active">SYSTEM BRIEFING</span>
        <span class="tech-tag">NPCI COMPATIBLE</span>
        <span class="tech-tag">FIPS 203 / 204 VALIDATED</span>
        <span class="text-neutral-500 font-mono text-[11px] hidden sm:inline">
          // REF: RBI-QSAFE-BFSI-2027
        </span>
      </div>

      <!-- Left-Aligned High-Impact Space Grotesk Header (NO Centered Pills, NO Gradients) -->
      <div class="max-w-5xl">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.08] mb-6 uppercase">
          Quantum-Safe, NPCI-Native Payment Infrastructure. Built for India.
        </h1>

        <!-- Crisp Technical Subtitle -->
        <p class="text-base sm:text-lg text-neutral-300 font-mono leading-relaxed max-w-3xl mb-10">
          Gajalogic delivers high-throughput UPI and IMPS switches embedded with Post-Quantum Cryptography (PQC). Eradicate legacy licensing bloat while neutralizing the "Harvest Now, Decrypt Later" threat.
        </p>

        <!-- Sharp Rectangular Precision Actions (NO Fuzzy Drop Shadows) -->
        <div class="flex flex-wrap items-center gap-4 mb-16">
          <a
            href={`${base}/platform`}
            class="btn-engineering"
          >
            <span>VIEW THE ARCHITECTURE</span>
            <span>&rarr;</span>
          </a>
          <a
            href={`${base}/developers`}
            class="btn-engineering-ghost"
          >
            <span>ACCESS PQC MIGRATION SANDBOX</span>
          </a>
          <a
            href="#parameters"
            class="text-xs font-mono text-neutral-400 hover:text-white px-2 py-2 transition-colors"
          >
            [EXAMINE TCO PARAMETERS]
          </a>
        </div>
      </div>

      <!-- Real-Time Hardware & Cryptographic Execution Telemetry (Sharp 1px Bordered Terminal) -->
      <div class="doc-panel">
        <div class="px-4 py-2 bg-[#0d0d0d] border-b border-white/10 flex flex-wrap items-center justify-between text-[11px] font-mono text-neutral-400">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-white"></span>
            <span class="text-white font-semibold">SWITCH_CORE_DAEMON // HOST_TELEMETRY</span>
          </div>
          <div class="flex items-center gap-4 text-[10px]">
            <span>TOPOLOGY: DISTRIBUTED SAGA MESH</span>
            <span class="text-neutral-600">|</span>
            <span>THROUGHPUT: 75,420 TPS</span>
            <span class="text-neutral-600">|</span>
            <span class="text-neutral-200">INTERNAL P99: 0.78 MS</span>
          </div>
        </div>

        <div class="p-5 bg-[#050505] font-mono text-xs text-neutral-300 space-y-2 overflow-x-auto leading-relaxed">
          <div class="text-neutral-600">// Real-time dual-rail cryptographic verification & CBS insulation trace</div>
          <div><span class="text-neutral-500">[04:57:02.114]</span> <span class="text-neutral-100">CORE_INIT:</span> Initializing in-memory O(1) VPA table: 48,200,000 entries mapped [138 µs lookup latency]</div>
          <div><span class="text-neutral-500">[04:57:02.118]</span> <span class="text-neutral-100">CBS_SHIELD:</span> In-memory balance shadow cache active &bull; 84.6% non-financial queries intercepted</div>
          <div><span class="text-neutral-500">[04:57:02.122]</span> <span class="text-neutral-100">CRYPTO_RAIL_01:</span> Classical RSA-2048 / SHA-256 [NPCI Interoperability: 100%]</div>
          <div><span class="text-neutral-500">[04:57:02.125]</span> <span class="text-neutral-100">CRYPTO_RAIL_02:</span> Post-Quantum NIST FIPS 203 (ML-KEM-1024) + FIPS 204 (ML-DSA-65) active</div>
          <div><span class="text-neutral-500">[04:57:02.130]</span> <span class="text-neutral-100">HNDL_AUDIT:</span> In-flight packet harvest defense: SECURE [Mathematical lattice bound &bull; 0.00% vulnerability]</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Technical Telemetry Parameter Grid (Sharp 1px Bordered Blocks) -->
  <section class="border-b border-white/10 bg-[#060606]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 divide-y sm:divide-y-0 sm:divide-x divide-white/10">
        {systemMetrics.map((m, idx) => (
          <div class={`${idx > 0 ? 'sm:pl-6' : ''} pt-4 sm:pt-0`}>
            <div class="flex items-center justify-between text-[10px] font-mono text-neutral-500 mb-1">
              <span>{m.id}</span>
              <span>MEASURED</span>
            </div>
            <div class="text-xs font-mono text-neutral-400 uppercase tracking-wider">{m.label}</div>
            <div class="text-2xl font-bold font-mono text-white mt-1 tracking-tight">{m.value}</div>
            <p class="text-[11px] font-mono text-neutral-500 mt-1">{m.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Strategic Imperative (Why Gajalogic?) Section -->
  <section class="border-b border-white/10 py-16 lg:py-24 bg-[#030303]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="mb-12 border-b border-white/10 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-mono text-neutral-400 uppercase tracking-widest block mb-2">
            // STRATEGIC ANALYSIS // SECTION 01
          </span>
          <h2 class="text-2xl sm:text-4xl font-bold text-white uppercase tracking-tight">
            The Strategic Imperative: Why Gajalogic?
          </h2>
        </div>
        <div class="text-xs font-mono text-neutral-500">
          TARGET AUDIENCE: C-SUITE (CEO // CTO // CISO)
        </div>
      </div>

      <!-- 3 Key Strategic Pillars in Razor-Sharp Modular Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Pillar 1: TCO Paradigm Shift -->
        <div class="doc-panel p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[11px] font-mono text-neutral-500 mb-4 pb-2 border-b border-white/10">
              <span>SECTION 1.1</span>
              <span class="text-white font-bold">-64% TCO DELTA</span>
            </div>
            <h3 class="text-xs font-mono text-neutral-400 uppercase tracking-widest mb-1">
              FINANCIAL ARCHITECTURE
            </h3>
            <h4 class="text-xl font-bold text-white mb-4 uppercase">
              The TCO Paradigm Shift
            </h4>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-mono mb-6">
              Monolithic legacy switches were not built for India's transaction volume. By migrating to Gajalogic's cloud-native architecture, banks replace exorbitant, volume-penalizing legacy licenses with a highly elastic, cost-optimized stack.
            </p>
            <ul class="space-y-2 text-xs font-mono text-neutral-400 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-white">&bull;</span>
                <span>Zero per-transaction volume penalty brackets</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-white">&bull;</span>
                <span>Runs on standard Kubernetes and commodity x86/ARM</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-white">&bull;</span>
                <span>Eliminates recurring vendor mainframe maintenance fees</span>
              </li>
            </ul>
          </div>
          <div class="pt-4 border-t border-white/10">
            <a href="#parameters" class="text-xs font-mono text-white hover:underline flex items-center justify-between">
              <span>[VIEW TCO PARAMETER AUDIT]</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Pillar 2: The Quantum Horizon -->
        <div class="doc-panel p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[11px] font-mono text-neutral-500 mb-4 pb-2 border-b border-white/10">
              <span>SECTION 1.2</span>
              <span class="text-white font-bold">FIPS 203 / 204</span>
            </div>
            <h3 class="text-xs font-mono text-neutral-400 uppercase tracking-widest mb-1">
              NATIONAL SECURITY
            </h3>
            <h4 class="text-xl font-bold text-white mb-4 uppercase">
              The Quantum Horizon
            </h4>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-mono mb-6">
              Financial data requiring long-term confidentiality is already at risk. Gajalogic neutralizes the "Harvest Now, Decrypt Later" threat by securing in-flight payloads and at-rest ledgers with NIST-finalized post-quantum algorithms (FIPS 204/ML-DSA, FIPS 205/SLH-DSA, FIPS 203/ML-KEM).
            </p>
            <ul class="space-y-2 text-xs font-mono text-neutral-400 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-white">&bull;</span>
                <span>Sovereign data sealed against future cryptanalytic collapse</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-white">&bull;</span>
                <span>Protects citizen account mappings & historical transactions</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-white">&bull;</span>
                <span>Hardware-accelerated PQC with &lt;1.0ms latency SLA</span>
              </li>
            </ul>
          </div>
          <div class="pt-4 border-t border-white/10">
            <a href="#hndl" class="text-xs font-mono text-white hover:underline flex items-center justify-between">
              <span>[DECONSTRUCT HNDL VECTOR]</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Pillar 3: Hybrid Crypto-Agility -->
        <div class="doc-panel p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[11px] font-mono text-neutral-500 mb-4 pb-2 border-b border-white/10">
              <span>SECTION 1.3</span>
              <span class="text-white font-bold">100% INTEROPERABLE</span>
            </div>
            <h3 class="text-xs font-mono text-neutral-400 uppercase tracking-widest mb-1">
              OPERATIONAL CONTINUITY
            </h3>
            <h4 class="text-xl font-bold text-white mb-4 uppercase">
              Hybrid Crypto-Agility
            </h4>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-mono mb-6">
              Innovation without disruption. Our infrastructure runs classical algorithms (RSA/ECC) and PQC in parallel, ensuring zero downtime for current NPCI transactions while securing long-lived financial data against future threats.
            </p>
            <ul class="space-y-2 text-xs font-mono text-neutral-400 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-white">&bull;</span>
                <span>Zero service disruption or ecosystem flag-day cutovers</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-white">&bull;</span>
                <span>Hot-swappable algorithm suites via centralized policy</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-white">&bull;</span>
                <span>Pre-aligned with GoI PQC Task Force 2027 timelines</span>
              </li>
            </ul>
          </div>
          <div class="pt-4 border-t border-white/10">
            <a href={`${base}/platform`} class="text-xs font-mono text-white hover:underline flex items-center justify-between">
              <span>[INSPECT CRYPTO-AGILITY SPEC]</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Data-Dense Parameter Table: Monolithic Legacy vs. Gajalogic TCO -->
  <section id="parameters" class="border-b border-white/10 py-16 lg:py-24 bg-[#050505]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="border-b border-white/10 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-mono text-neutral-400 uppercase tracking-widest block mb-2">
            // SYSTEMS ENGINEERING AUDIT // TABLE 01
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white uppercase tracking-tight">
            TCO Parameter Audit: Legacy Monolith vs. Gajalogic
          </h2>
        </div>
        <div class="text-xs font-mono text-neutral-500">
          BENCHMARK: 25,000 BASELINE TPS // FESTIVE SURGE: 75,000 TPS
        </div>
      </div>

      <!-- High-Density Engineering Table -->
      <div class="border border-white/10 overflow-x-auto bg-[#080808]">
        <table class="dense-table">
          <thead>
            <tr>
              <th class="w-1/5">SYSTEM PARAMETER</th>
              <th class="w-2/5">MONOLITHIC LEGACY SWITCH (WAY4 / BASE24 / FIS)</th>
              <th class="w-2/5">GAJALOGIC CLOUD-NATIVE STACK</th>
              <th class="w-1/6">DELTA / SPEC</th>
            </tr>
          </thead>
          <tbody>
            {tcoParameters.map((row) => (
              <tr>
                <td class="font-semibold text-white bg-[#0a0a0a] border-r border-white/10">{row.parameter}</td>
                <td class="text-neutral-400 border-r border-white/10">{row.legacy}</td>
                <td class="text-neutral-200 bg-white/[0.01] border-r border-white/10 font-medium">{row.gajalogic}</td>
                <td class="text-white font-bold">{row.delta}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- "Harvest Now, Decrypt Later" Threat Vector Schematics -->
  <section id="hndl" class="border-b border-white/10 py-16 lg:py-24 bg-[#030303]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="border-b border-white/10 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-mono text-neutral-400 uppercase tracking-widest block mb-2">
            // CRYPTANALYTIC THREAT AUDIT // SECTION 02
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white uppercase tracking-tight">
            Threat Deconstruction: "Harvest Now, Decrypt Later" (HNDL)
          </h2>
        </div>
        <div class="text-xs font-mono text-neutral-500">
          STANDARDS: NIST FIPS 203 (ML-KEM) // FIPS 204 (ML-DSA)
        </div>
      </div>

      <!-- 3-Phase Threat Timeline Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {hndlAttackVectors.map((v) => (
          <div class="doc-panel p-6 space-y-4">
            <div class="flex items-center justify-between text-[10px] font-mono text-neutral-500 pb-2 border-b border-white/10">
              <span class="text-white font-bold">{v.phase}</span>
              <span class="tech-tag !text-[9px]">{v.state}</span>
            </div>
            <div class="text-xs font-mono text-neutral-400 uppercase tracking-wider">{v.timeframe}</div>
            
            <div class="p-3 bg-[#0d0d0d] border border-white/10 text-xs font-mono text-neutral-400 leading-relaxed">
              <span class="text-white font-bold block mb-1 uppercase text-[10px]">// VULNERABILITY MECHANISM</span>
              {v.mechanism}
            </div>

            <div class="p-3 bg-[#111111] border border-white/20 text-xs font-mono text-neutral-200 leading-relaxed">
              <span class="text-white font-bold block mb-1 uppercase text-[10px]">// GAJALOGIC COUNTERMEASURE</span>
              {v.countermeasure}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Technical Directory: NPCI Product Suite -->
  <section class="border-b border-white/10 py-16 lg:py-24 bg-[#050505]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="border-b border-white/10 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-mono text-neutral-400 uppercase tracking-widest block mb-2">
            // PRODUCT SPECIFICATION CATALOG // SECTION 03
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white uppercase tracking-tight">
            NPCI Product Suite Specifications
          </h2>
        </div>
        <div class="text-xs font-mono text-neutral-500">
          DIRECTORY OF DEPLOYABLE SWITCH ENGINES
        </div>
      </div>

      <!-- Product Directory Rows -->
      <div class="border border-white/10 divide-y divide-white/10 bg-[#080808]">
        {npciProducts.map((p) => (
          <div class="p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-6 hover:bg-neutral-900/50 transition-colors">
