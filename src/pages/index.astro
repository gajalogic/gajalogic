                <span class="tech-tag tech-tag-active">{p.code}</span>
                <span class="text-xs font-mono text-neutral-500 uppercase">{p.target}</span>
              </div>
              <h3 class="text-xl font-bold text-white uppercase tracking-tight">
                <a href={p.slug} class="hover:underline">
                  {p.name}
