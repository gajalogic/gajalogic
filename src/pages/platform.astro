---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const platformMetrics = [
  { value: '75,000+', label: 'Elastic Peak TPS', sub: 'Horizontally scaled saga workers' },
  { value: '0.78 ms', label: 'Switch Transit (P99)', sub: 'Zero garbage collection pauses' },
  { value: '2x', label: 'Parallel Crypto Families', sub: 'Classical RSA/ECC + PQC concurrently' },
  { value: '84.6%', label: 'CBS Read Offload', sub: 'Non-financial queries resolved in-memory' },
];

const platformPillars = [
  {
    eyebrow: 'ENGINE 01 // CRYPTOGRAPHY',
    title: 'Crypto-Agility Engine',
    desc: 'Classical (RSA/ECC) and Post-Quantum (ML-KEM/ML-DSA) encryption run concurrently on every transaction. Swap algorithms via centralized configuration rather than hard-coded software updates, ensuring immediate response to future vulnerabilities.',
    href: `${base}/platform/crypto-agility`,
    linkLabel: 'Explore the Hybrid Cryptographic Engine',
    accent: 'text-[#3e61ff]',
    iconPath: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  },
  {
    eyebrow: 'ENGINE 02 // LEDGERS',
    title: 'Cloud-Native Ledgers',
    desc: 'Event-driven clearing and settlement on NATS JetStream and Benthos. Financial records and ISO 8583 / ISO 20022 payloads are written to immutable ledgers over post-quantum TLS handshakes, safeguarding historical data integrity.',
    href: `${base}/platform/cloud-native-ledgers`,
    linkLabel: 'Explore High-Throughput Ledgers',
    accent: 'text-purple-600',
    iconPath: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4',
  },
];

const runtimePrinciples = [
  {
    title: 'Elastic Scale-Out',
    desc: 'Kubernetes-native saga workers auto-scale horizontally to absorb festival-grade surges within seconds. No vertical hardware ceilings, no per-TPS license penalties.',
    tag: 'Cloud-Native',
  },
  {
    title: 'Event-First Clearing',
    desc: 'Every financial event is a message, not a database row lock. Asynchronous pipelines decouple real-time authorization from downstream settlement.',
    tag: 'NATS JetStream',
  },
  {
    title: 'Config-Driven Crypto',
    desc: 'Algorithm selection is runtime configuration, not compiled code. The cryptographic stack evolves as fast as the threat landscape.',
    tag: 'Zero-Downtime',
  },
];
---

<Layout
  title="Platform | GajaLogic Core Platform Architecture"
  description="The Gajalogic core platform: a hybrid cryptographic engine running classical and post-quantum algorithms in parallel, plus cloud-native event-driven ledgers."
>
  <PageHeader
    eyebrow="Core Platform Architecture"
    title="The Gajalogic Platform"
    subtitle="For CTOs and Chief Architects: a decoupled, cloud-native runtime combining high-concurrency micro-sagas, event-driven ledgers, and hardware-isolated post-quantum cryptography."
    badge="Cloud-Native // PQC-Ready"
  >
    <div slot="actions">
      <a href="#pillars" class="btn-unibase-primary !py-2.5 !px-5 !text-sm">
        Inspect the Two Engines
      </a>
      <a href={`${base}/developers/sandbox`} class="btn-unibase-secondary !py-2.5 !px-5 !text-sm">
        Try the Sandbox
      </a>
    </div>
  </PageHeader>

  <!-- Platform Metric Strip -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-16 relative z-10">
    <div class="unibase-card p-6 sm:p-8 shadow-sm">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 divide-y lg:divide-y-0 lg:divide-x divide-[#dadcdf]">
        {platformMetrics.map((m) => (
          <div class="pt-4 lg:pt-0 lg:px-4 text-center sm:text-left">
            <span class="text-xs font-mono uppercase tracking-wider text-[#3e61ff] block mb-1">{m.label}</span>
            <div class="text-3xl sm:text-4xl font-extrabold font-mono text-[#0f1419] tracking-tight">{m.value}</div>
            <p class="text-xs text-gray-500 mt-1">{m.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Two Engine Pillars -->
  <section id="pillars" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="text-center max-w-3xl mx-auto">
      <span class="mono-tag font-semibold uppercase tracking-wider mb-2 inline-block">Platform Deep Dives</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0f1419] tracking-tight mt-2">
        Two Engines, One Runtime
      </h2>
      <p class="text-gray-500 mt-3 text-base">
        Every Gajalogic switch is composed from the same two architectural engines. Explore each in depth.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {platformPillars.map((pillar) => (
        <div class="unibase-card p-8 flex flex-col justify-between relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#3e61ff]/0 group-hover:via-[#3e61ff]/40 to-transparent transition-all duration-500"></div>
          <div>
            <div class="p-3 w-fit rounded-xl bg-blue-50 border border-blue-200 text-[#3e61ff] mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={pillar.iconPath}/>
              </svg>
            </div>
            <span class={`text-xs font-mono font-bold uppercase tracking-wider block mb-2 ${pillar.accent}`}>
              {pillar.eyebrow}
            </span>
            <h3 class="text-2xl font-extrabold text-[#0f1419] mb-3">
              {pillar.title}
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              {pillar.desc}
            </p>
          </div>
          <a
            href={pillar.href}
            class="inline-flex items-center text-sm font-bold text-[#3e61ff] group-hover:text-[#3151e6] group-hover:translate-x-1 transition-all"
          >
            <span>{pillar.linkLabel}</span>
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Runtime Principles -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[#dadcdf]">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-[#3e61ff] mb-2">Runtime Principles</h2>
      <h3 class="text-3xl font-extrabold text-[#0f1419] tracking-tight">
        Architectural Non-Negotiables
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {runtimePrinciples.map((p, i) => (
        <div class="unibase-card p-7 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-[#3e61ff] font-bold mb-3 block">0{i + 1} //</span>
            <h4 class="text-lg font-bold text-[#0f1419] mb-2">{p.title}</h4>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">{p.desc}</p>
          </div>
          <span class="mono-tag text-[11px] w-fit mt-5">{p.tag}</span>
        </div>
      ))}
    </div>
  </section>

  <CtaBanner
    title="See the Platform Move Before You Commit a Team"
    subtitle="Run simulated UPI pay/collect traffic through the live sandbox and watch the hybrid PQC key exchange negotiate in real time."
    buttonText="Open the PQC Migration Sandbox"
    buttonHref={`${base}/developers/sandbox`}
    secondaryText="View the NPCI Product Suite"
    secondaryHref={`${base}/products`}
  />
</Layout>
