---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  badge?: string;
}

const { eyebrow, title, subtitle, badge } = Astro.props;
---

<section class="relative pt-12 pb-16 md:pt-16 md:pb-20 overflow-hidden border-b border-[#dadcdf]">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    {badge && (
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-5 rounded-full text-xs font-semibold bg-blue-50 text-[#3e61ff] border border-blue-200 shadow-sm">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#3e61ff]"></span>
        {badge}
      </div>
    )}

    {eyebrow && (
      <p class="text-xs sm:text-sm font-mono font-bold tracking-widest text-[#3e61ff] uppercase mb-3">
        {eyebrow}
      </p>
    )}

    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#0f1419] mb-5 max-w-4xl mx-auto leading-tight">
      {title}
    </h1>

    <p class="text-base sm:text-lg text-gray-600 max-w-3xl mx-auto font-normal leading-relaxed">
      {subtitle}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <slot name="actions" />
    </div>
  </div>
</section>
