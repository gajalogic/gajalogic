---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'NPCI PRODUCT SPECIFICATIONS',
    links: [
      { name: 'UPI Acquiring Switch', href: `${base}/products/upi-acquiring` },
      { name: 'UPI Issuing Switch', href: `${base}/products/upi-issuing` },
      { name: 'TPAP Infrastructure', href: `${base}/products/upi-tpap` },
      { name: 'RuPay Issuing & Acquiring', href: `${base}/products/rupay-cards` },
      { name: 'NCMC Transit Solutions', href: `${base}/products/ncmc-transit` },
    ],
  },
  {
    title: 'PLATFORM ARCHITECTURE',
    links: [
      { name: 'Engine Overview', href: `${base}/platform` },
      { name: 'Distributed Saga Runtime', href: `${base}/platform#runtime` },
      { name: 'Hardware Acceleration', href: `${base}/hardware` },
      { name: 'Post-Quantum Encryption', href: `${base}/compliance#fips` },
    ],
  },
  {
    title: 'ENGINEERING & TOOLING',
    links: [
      { name: 'API Reference', href: `${base}/developers#api` },
      { name: 'Rust & Python SDKs', href: `${base}/developers#sdks` },
      { name: 'CLI Tooling (gajactl)', href: `${base}/developers#cli` },
      { name: 'Hardware Simulator', href: `${base}/developers#sandbox` },
    ],
  },
  {
    title: 'STANDARDS & TRUST',
    links: [
      { name: 'NIST FIPS 203 / 204 Standards', href: `${base}/compliance#certifications` },
      { name: 'SOC 2 Type II Reports', href: `${base}/compliance#soc2` },
      { name: 'FIPS 140-3 Hardware Enclaves', href: `${base}/compliance#fips` },
      { name: 'RBI Cyber Security Framework', href: `${base}/compliance#security` },
    ],
  },
  {
    title: 'CORPORATE & AUDITS',
    links: [
      { name: 'Mission & Systems Team', href: `${base}/company#about` },
      { name: 'Architects & Leadership', href: `${base}/company#leadership` },
      { name: 'Systems Engineering Careers', href: `${base}/company#careers` },
      { name: 'Contact & Procurement', href: `${base}/company#contact` },
    ],
  },
];
---

<footer class="mt-auto border-t border-white/10 bg-[#030303] text-neutral-400 font-mono text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 mb-12">
      
      <!-- Brand & Metadata Column -->
      <div class="col-span-2 md:col-span-3 lg:col-span-1 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-5 h-5 border border-white/20 bg-neutral-900 flex items-center justify-center font-bold text-white text-[10px]">
            G
          </div>
          <span class="text-sm font-bold text-white tracking-widest uppercase">
            GAJALOGIC<span class="text-neutral-500">//</span>SYS
          </span>
        </div>
        
        <p class="text-[11px] text-neutral-500 leading-relaxed">
          National payment switch infrastructure, distributed saga orchestration, and post-quantum cryptographic execution engines.
        </p>

        <div class="p-2 border border-white/10 bg-[#080808] text-[10px] space-y-1">
          <div class="text-neutral-400 font-bold flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 bg-white"></span>
            NETWORK STATE: VERIFIED
          </div>
          <div class="text-neutral-500">NPCI CORE: CONNECTED</div>
          <div class="text-neutral-500">PQC SUITE: FIPS 203/204 ACTIVE</div>
        </div>
      </div>

      <!-- Links Columns -->
      {footerSections.map((section) => (
        <div class="space-y-3">
          <h3 class="text-[10px] font-bold text-neutral-300 uppercase tracking-widest border-b border-white/10 pb-1">
            {section.title}
          </h3>
          <ul class="space-y-1.5 text-[11px]">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-neutral-500 hover:text-white transition-colors block py-0.5"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <!-- Bottom Technical Metadata Bar -->
    <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-[10px] text-neutral-600">
      <div class="flex items-center gap-4">
        <span>© {currentYear} GAJALOGIC SYSTEMS INC.</span>
        <span>SECURITY SPEC: FIPS 203 / FIPS 204</span>
        <span>LATENCY SLA: &lt; 1.0 MS P99</span>
      </div>
      <div class="flex items-center space-x-6">
        <a href={`${base}/compliance`} class="hover:text-neutral-400 transition-colors">[PRIVACY PROTOCOL]</a>
        <a href={`${base}/compliance`} class="hover:text-neutral-400 transition-colors">[TERMS OF SERVICE]</a>
        <a href={`${base}/compliance#security`} class="hover:text-neutral-400 transition-colors">[SECURITY ADVISORY]</a>
      </div>
    </div>
  </div>
</footer>
