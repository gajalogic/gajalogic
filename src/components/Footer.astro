---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'NPCI Product Suite',
    links: [
      { name: 'UPI Acquiring Switch', href: `${base}/products/upi-acquiring` },
      { name: 'UPI Issuing Switch', href: `${base}/products/upi-issuing` },
      { name: 'TPAP Infrastructure', href: `${base}/products/upi-tpap` },
      { name: 'RuPay Issuing & Acquiring', href: `${base}/products/rupay-cards` },
      { name: 'NCMC Transit Solutions', href: `${base}/products/ncmc-transit` },
    ],
  },
  {
    title: 'Platform & Tech',
    links: [
      { name: 'Architecture Overview', href: `${base}/platform` },
      { name: 'Distributed Saga Engine', href: `${base}/platform#runtime` },
      { name: 'Hardware Acceleration', href: `${base}/hardware` },
      { name: 'Post-Quantum Security', href: `${base}/compliance#fips` },
    ],
  },
  {
    title: 'Developers',
    links: [
      { name: 'API Reference', href: `${base}/developers#api` },
      { name: 'Python & Rust SDKs', href: `${base}/developers#sdks` },
      { name: 'CLI Tooling (gajactl)', href: `${base}/developers#cli` },
      { name: 'Hardware Simulator', href: `${base}/developers#sandbox` },
    ],
  },
  {
    title: 'Trust & Governance',
    links: [
      { name: 'Compliance Certifications', href: `${base}/compliance#certifications` },
      { name: 'SOC 2 & ISO 27001', href: `${base}/compliance#soc2` },
      { name: 'FIPS 140-3 Hardware', href: `${base}/compliance#fips` },
      { name: 'RBI Cyber Security Framework', href: `${base}/compliance#security` },
    ],
  },
  {
    title: 'Company',
    links: [
      { name: 'About Gajalogic', href: `${base}/company#about` },
      { name: 'Leadership & Vision', href: `${base}/company#leadership` },
      { name: 'Careers & Culture', href: `${base}/company#careers` },
      { name: 'Contact & Sales', href: `${base}/company#contact` },
    ],
  },
];
---

<footer class="mt-auto border-t border-white/10 bg-slate-950/90 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 mb-12">
      
      <!-- Brand & Status Column -->
      <div class="col-span-2 md:col-span-3 lg:col-span-1 space-y-4">
        <a href={`${base}/`} class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-sky-500 to-indigo-600 p-[1px]">
            <div class="w-full h-full bg-slate-950 rounded-[7px] flex items-center justify-center">
              <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
          </div>
          <span class="text-lg font-bold text-white font-mono">Gaja<span class="text-sky-400">Logic</span></span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed font-light">
          High-throughput national payment switches, distributed saga orchestration, and post-quantum cryptographic security.
        </p>

        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-[11px] font-medium bg-emerald-950/60 text-emerald-400 border border-emerald-500/30 font-mono">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          All Payment Switches Operational
        </div>
      </div>

      <!-- Links Columns -->
      {footerSections.map((section) => (
        <div class="space-y-3">
          <h3 class="text-xs font-semibold text-white uppercase tracking-wider font-mono">
            {section.title}
          </h3>
          <ul class="space-y-2 text-xs">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-400 hover:text-sky-400 transition-colors duration-150 inline-block py-0.5"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 font-mono">
      <p>© {currentYear} Gajalogic Systems Inc. Sovereign payment technology.</p>
      <div class="flex items-center space-x-6">
        <a href={`${base}/compliance`} class="hover:text-slate-400 transition-colors">Privacy Policy</a>
        <a href={`${base}/compliance`} class="hover:text-slate-400 transition-colors">Terms of Service</a>
        <a href={`${base}/compliance#security`} class="hover:text-slate-400 transition-colors">Security Disclosure</a>
        <a href={`${base}/developers`} class="hover:text-slate-400 transition-colors">API Status</a>
      </div>
    </div>
  </div>
</footer>
