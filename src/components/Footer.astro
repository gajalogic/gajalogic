---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'Products',
    links: [
      { name: 'UPI Acquiring Switch', href: `${base}/products/upi-acquiring` },
      { name: 'UPI Issuing Switch', href: `${base}/products/upi-issuing` },
      { name: 'TPAP Infrastructure', href: `${base}/products/upi-tpap` },
      { name: 'RuPay Issuing & Acquiring', href: `${base}/products/rupay-cards` },
      { name: 'NCMC Transit Solutions', href: `${base}/products/ncmc-transit` },
    ],
  },
  {
    title: 'Platform',
    links: [
      { name: 'Architecture Overview', href: `${base}/platform` },
      { name: 'Distributed Sagas', href: `${base}/platform#runtime` },
      { name: 'Hardware Acceleration', href: `${base}/hardware` },
      { name: 'Crypto-Agility Engine', href: `${base}/platform` },
    ],
  },
  {
    title: 'Resources',
    links: [
      { name: 'Documentation', href: `${base}/developers` },
      { name: 'API Reference', href: `${base}/developers#api` },
      { name: 'Python & Rust SDKs', href: `${base}/developers#sdks` },
      { name: 'PQC Migration Sandbox', href: `${base}/developers` },
    ],
  },
  {
    title: 'Company',
    links: [
      { name: 'About Us', href: `${base}/company#about` },
      { name: 'Leadership & Team', href: `${base}/company#leadership` },
      { name: 'Compliance & Trust', href: `${base}/compliance` },
      { name: 'Contact Sales', href: `${base}/company#contact` },
    ],
  },
];
---

<footer class="mt-auto border-t border-[#dadcdf] bg-white text-gray-600 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 mb-12">
      
      <!-- Brand & Status Column -->
      <div class="col-span-2 md:col-span-3 lg:col-span-2 space-y-4">
        <a href={`${base}/`} class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-[#3e61ff] flex items-center justify-center text-white font-bold text-sm">
            G
          </div>
          <span class="text-xl font-extrabold tracking-tight text-[#0f1419]">
            Gaja<span class="text-[#3e61ff]">Logic</span>
          </span>
        </a>
        
        <p class="text-xs text-gray-500 leading-relaxed max-w-sm">
          Open quantum-safe payment infrastructure for high-throughput national rails. Sub-millisecond distributed sagas, in-memory core banking offloading, and post-quantum encryption.
        </p>

        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          All Payment Switches Operational
        </div>
      </div>

      <!-- Links Columns -->
      {footerSections.map((section) => (
        <div class="space-y-3">
          <h3 class="text-xs font-bold text-[#0f1419] uppercase tracking-wider">
            {section.title}
          </h3>
          <ul class="space-y-2 text-xs">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-500 hover:text-[#3e61ff] transition-colors"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <p>© {currentYear} GajaLogic Systems Inc. All rights reserved.</p>
      <div class="flex items-center space-x-6">
        <a href={`${base}/compliance`} class="hover:text-gray-600 transition-colors">Privacy Policy</a>
        <a href={`${base}/compliance`} class="hover:text-gray-600 transition-colors">Terms of Service</a>
        <a href={`${base}/compliance#security`} class="hover:text-gray-600 transition-colors">Security Disclosure</a>
      </div>
    </div>
  </div>
</footer>
