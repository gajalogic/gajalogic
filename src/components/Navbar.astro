---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const productSubLinks = [
  { code: 'PRD-01', name: 'UPI Acquiring', href: `${base}/products/upi-acquiring`, spec: 'Sub-ms Saga // O(1) VPA Cache' },
  { code: 'PRD-02', name: 'UPI Issuing Switch', href: `${base}/products/upi-issuing`, spec: 'CBS Offload // PQC Shield' },
  { code: 'PRD-03', name: 'TPAP Infrastructure', href: `${base}/products/upi-tpap`, spec: 'Decoupled PQC // Multi-PSP' },
  { code: 'PRD-04', name: 'RuPay Issuing & Acquiring', href: `${base}/products/rupay-cards`, spec: 'EMV Switch // CMS Replacement' },
  { code: 'PRD-05', name: 'NCMC & Transit Solutions', href: `${base}/products/ncmc-transit`, spec: '<240ms Turnstiles // 48KB Silicon' },
];

const navLinks = [
  { name: 'PRODUCTS', href: `${base}/products`, hasDropdown: true },
  { name: 'PLATFORM', href: `${base}/platform` },
  { name: 'HARDWARE', href: `${base}/hardware` },
  { name: 'DEVELOPERS', href: `${base}/developers` },
  { name: 'COMPLIANCE', href: `${base}/compliance` },
  { name: 'COMPANY', href: `${base}/company` },
];

const homeUrl = `${base}/` || '/';

function isActive(href: string) {
  if (href === homeUrl || href === `${base}`) {
    return currentPath === href || currentPath === `${href}/`;
  }
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 w-full bg-[#030303] border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      
      <!-- Left: Technical Brand Ident -->
      <div class="flex items-center gap-6">
        <a href={homeUrl} class="flex items-center gap-3 group">
          <div class="w-6 h-6 border border-white/20 bg-neutral-900 flex items-center justify-center font-mono font-bold text-xs text-white group-hover:border-white transition-colors">
            G
          </div>
          <div class="flex flex-col">
            <span class="text-xs font-mono font-bold tracking-widest text-white uppercase">
              GAJALOGIC<span class="text-neutral-500">//</span>SYS
            </span>
            <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-tight">
              PQC NATIONAL PAYMENT SWITCHES
            </span>
          </div>
        </a>

        <!-- System State Pill (Strict Monochromatic) -->
        <div class="hidden lg:flex items-center gap-1.5 px-2 py-0.5 border border-white/10 bg-[#080808] text-[10px] font-mono text-neutral-400">
          <span class="w-1.5 h-1.5 bg-white"></span>
          <span>STATUS: OPERATIONAL [REV 4.2.0]</span>
        </div>
      </div>

      <!-- Center: Technical Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          if (link.hasDropdown) {
            return (
              <div class="relative group">
                <a
                  href={link.href}
                  class={`px-3 py-1.5 text-xs font-mono font-medium transition-colors flex items-center gap-1.5 ${
                    active
                      ? 'text-white bg-white/10 border-b border-white'
                      : 'text-neutral-400 hover:text-white hover:bg-neutral-900'
                  }`}
                >
                  <span>{link.name}</span>
                  <span class="text-[9px] text-neutral-600 group-hover:text-neutral-300 font-mono">[+]</span>
                </a>

                <!-- Sharp Technical Dropdown Panel -->
                <div class="absolute left-0 top-full pt-1 w-96 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-100 z-50">
                  <div class="bg-[#080808] border border-white/10 shadow-none p-3 divide-y divide-white/10">
                    <div class="pb-2 px-1 text-[10px] font-mono text-neutral-400 uppercase tracking-widest flex justify-between">
                      <span>NPCI PRODUCT SPECIFICATION</span>
                      <span class="text-neutral-600">INDEX // 5 ENTRIES</span>
                    </div>
                    <div class="py-2 space-y-1">
                      {productSubLinks.map((sub) => (
                        <a
                          href={sub.href}
                          class="block p-2 hover:bg-neutral-900 border border-transparent hover:border-white/10 transition-colors group/item"
                        >
                          <div class="flex items-center justify-between text-xs font-mono font-semibold text-neutral-200 group-hover/item:text-white">
                            <span>{sub.code}: {sub.name}</span>
                            <span class="text-[10px] text-neutral-600 group-hover/item:text-white">&rarr;</span>
                          </div>
                          <div class="text-[11px] font-mono text-neutral-500 mt-0.5">{sub.spec}</div>
                        </a>
                      ))}
                    </div>
                    <div class="pt-2 px-1">
                      <a
                        href={`${base}/products`}
                        class="text-[11px] font-mono text-neutral-400 hover:text-white flex items-center justify-between"
                      >
                        <span>[VIEW COMPLETE SPECIFICATION MATRIX]</span>
                        <span>&rarr;</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.href}
              class={`px-3 py-1.5 text-xs font-mono font-medium transition-colors ${
                active
                  ? 'text-white bg-white/10 border-b border-white'
                  : 'text-neutral-400 hover:text-white hover:bg-neutral-900'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Right: Technical Actions -->
      <div class="hidden md:flex items-center space-x-3">
        <a
          href={`${base}/developers`}
          class="text-xs font-mono text-neutral-400 hover:text-white px-2 py-1 transition-colors"
        >
          [DOCS]
        </a>
        <a
          href={`${base}/company#contact`}
          class="btn-engineering !py-1 !px-3 !text-xs !border-white/20"
        >
          REQUEST SPEC AUDIT
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
          class="p-1.5 border border-white/20 text-neutral-400 hover:text-white hover:border-white focus:outline-none"
        >
          <span class="text-xs font-mono font-bold">[MENU]</span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Technical Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-white/10 bg-[#080808] px-4 py-4 space-y-3 font-mono text-xs">
    <div class="text-[10px] text-neutral-500 uppercase tracking-widest pb-1 border-b border-white/10">
      SYSTEM DIRECTORY // NAVIGATION
    </div>
    {navLinks.map((link) => (
      <div>
        <a
          href={link.href}
          class="block py-1 text-neutral-300 hover:text-white font-medium"
        >
          &gt; {link.name}
        </a>
        {link.hasDropdown && (
          <div class="pl-4 py-1 space-y-1 text-neutral-500">
            {productSubLinks.map((sub) => (
              <a href={sub.href} class="block py-0.5 text-[11px] hover:text-white">
                -- {sub.name}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
    <div class="pt-3 border-t border-white/10 flex flex-col space-y-2">
      <a
        href={`${base}/developers`}
        class="text-center py-1.5 border border-white/20 text-neutral-300 hover:text-white"
      >
        API & ARCHITECTURE DOCS
      </a>
      <a
        href={`${base}/company#contact`}
        class="text-center py-1.5 bg-white text-black font-semibold"
      >
        REQUEST SPECIFICATION AUDIT
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
  });
</script>
