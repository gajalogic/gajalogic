---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  {
    name: 'Products',
    href: `${base}/products`,
    subs: [
      { code: 'UPI', name: 'UPI Acquiring Switch', href: `${base}/products/upi-acquiring`, desc: 'Sub-ms saga & O(1) in-memory VPA lookup' },
      { code: 'CBS', name: 'UPI Issuing Switch', href: `${base}/products/upi-issuing`, desc: 'In-memory CBS offload & PQC shield' },
      { code: 'TPAP', name: 'TPAP Infrastructure', href: `${base}/products/upi-tpap`, desc: 'Decoupled PQC for fintech consumer apps' },
      { code: 'CARD', name: 'RuPay Issuing & Acquiring', href: `${base}/products/rupay-cards`, desc: 'EMV switch replacing legacy CMS' },
      { code: 'NCMC', name: 'NCMC & Transit Solutions', href: `${base}/products/ncmc-transit`, desc: '<240ms turnstiles & offline wallets' },
    ],
    dropdownLabel: 'NPCI Product Suite',
    dropdownDesc: 'Post-quantum national payment switches',
  },
  {
    name: 'Platform',
    href: `${base}/platform`,
    subs: [
      { code: 'PQC', name: 'Crypto-Agility Engine', href: `${base}/platform/crypto-agility`, desc: 'Hybrid classical + PQC parallel execution' },
      { code: 'LEDGER', name: 'Cloud-Native Ledgers', href: `${base}/platform/cloud-native-ledgers`, desc: 'Event-driven clearing & immutable journals' },
    ],
    dropdownLabel: 'Core Platform Architecture',
    dropdownDesc: 'The engine underneath every switch',
  },
  {
    name: 'Hardware',
    href: `${base}/hardware`,
    subs: [
      { code: 'EDGE', name: 'OpenCPU Soundbox', href: `${base}/hardware/opencpu-soundbox`, desc: 'Sub-₹600 BoM 4G payment device' },
      { code: 'HSM', name: 'Enterprise HSM', href: `${base}/hardware/enterprise-hsm`, desc: 'Thales Luna + QRNG root of trust' },
      { code: 'BLE', name: 'BLE Contactless', href: `${base}/hardware/ble-contactless`, desc: 'Offline beacon payment broadcasting' },
    ],
    dropdownLabel: 'Hardware & Edge Security',
    dropdownDesc: 'Edge devices and enterprise root of trust',
  },
  {
    name: 'Developers',
    href: `${base}/developers`,
    subs: [
      { code: 'DEMO', name: 'PQC Migration Sandbox', href: `${base}/developers/sandbox`, desc: 'Simulated UPI pay/collect & key exchange' },
      { code: 'DIAG', name: 'Architecture Blueprints', href: `${base}/developers/architecture`, desc: 'Downloadable Mermaid.js diagrams' },
      { code: 'API', name: 'Docs & Test Harness', href: `${base}/developers/docs`, desc: 'API reference, SDKs & spec-driven tests' },
    ],
    dropdownLabel: 'Developers & Migration',
    dropdownDesc: 'Show, don\u2019t tell',
  },
  {
    name: 'Compliance',
    href: `${base}/compliance`,
    subs: [
      { code: 'RBI', name: 'RBI Q-SAFE Alignment', href: `${base}/compliance/rbi-qsafe`, desc: 'GoI PQC Task Force 2027 readiness' },
      { code: 'PA-P', name: 'PA-P Framework', href: `${base}/compliance/pa-p-framework`, desc: 'Payment Aggregator authorization ready' },
      { code: 'CBOM', name: 'Cryptographic Bill of Materials', href: `${base}/compliance/cbom`, desc: 'Automated crypto asset inventory' },
    ],
    dropdownLabel: 'Compliance & Trust Center',
    dropdownDesc: 'For CISOs, risk & compliance heads',
  },
  { name: 'Company', href: `${base}/company` },
];

const homeUrl = `${base}/` || '/';

function isActive(href: string) {
  if (href === homeUrl || href === `${base}`) {
    return currentPath === href || currentPath === `${href}/`;
  }
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md border-b border-[#dadcdf]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">

      <!-- Left: Logo -->
      <a href={homeUrl} class="flex items-center">
        <span class="text-xl font-extrabold tracking-tight text-[#0f1419]">
          Gaja<span class="text-[#3e61ff]">Logic</span>
        </span>
      </a>

      <!-- Center: Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          if (link.subs) {
            return (
              <div class="relative group">
                <a
                  href={link.href}
                  class={`px-3 py-2 rounded-lg text-sm font-semibold transition-colors flex items-center gap-1.5 ${
                    active
                      ? 'text-[#3e61ff] bg-blue-50/70'
                      : 'text-[#0f1419] hover:text-[#3e61ff] hover:bg-gray-50'
                  }`}
                >
                  <span>{link.name}</span>
                  <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-[#3e61ff] transition-transform group-hover:rotate-180 duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </a>

                <!-- Dropdown Menu -->
                <div class="absolute left-0 top-full pt-2 w-80 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class="bg-white border border-[#dadcdf] shadow-xl rounded-2xl p-3 divide-y divide-gray-100">
                    <div class="pb-2 px-2 pt-1">
                      <div class="text-[11px] font-bold text-[#3e61ff] uppercase tracking-wider">
                        {link.dropdownLabel}
                      </div>
                      <div class="text-[11px] text-gray-500">{link.dropdownDesc}</div>
                    </div>
                    <div class="py-2 space-y-1">
                      {link.subs.map((sub) => (
                        <a
                          href={sub.href}
                          class="block p-2 rounded-xl text-xs hover:bg-gray-50 transition-colors group/item"
                        >
                          <div class="font-bold text-[#0f1419] group-hover/item:text-[#3e61ff] flex items-center justify-between">
                            <span>{sub.name}</span>
                            <span class="text-[10px] text-gray-400 group-hover/item:text-[#3e61ff]">&rarr;</span>
                          </div>
                          <div class="text-[11px] text-gray-500 mt-0.5">{sub.desc}</div>
                        </a>
                      ))}
                    </div>
                    <div class="pt-2 px-2">
                      <a
                        href={link.href}
                        class="text-xs font-bold text-[#3e61ff] hover:underline flex items-center justify-between"
                      >
                        <span>View Section Overview</span>
                        <span>&rarr;</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-lg text-sm font-semibold transition-colors ${
                active
                  ? 'text-[#3e61ff] bg-blue-50/70'
                  : 'text-[#0f1419] hover:text-[#3e61ff] hover:bg-gray-50'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Right: Action CTA -->
      <div class="hidden md:flex items-center space-x-4">
        <a
          href={`${base}/developers/docs`}
          class="text-sm font-semibold text-[#0f1419] hover:text-[#3e61ff] transition-colors"
        >
          Docs
        </a>
        <a
          href={`${base}/company/contact`}
          class="btn-unibase-primary !py-2.5 !px-5 !text-sm"
        >
          Get Started
        </a>
      </div>

      <!-- Mobile Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          aria-label="Toggle mobile menu"
          class="p-2 rounded-lg text-gray-700 hover:text-black hover:bg-gray-100"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[#dadcdf] bg-white px-4 py-4 space-y-2">
    {navLinks.map((link) => (
      <div>
        <a
          href={link.href}
          class="block px-3 py-2 rounded-lg text-base font-semibold text-[#0f1419] hover:bg-gray-50 hover:text-[#3e61ff]"
        >
          {link.name}
        </a>
        {link.subs && (
          <div class="pl-4 py-1 space-y-1 border-l-2 border-gray-100 ml-3">
            {link.subs.map((sub) => (
              <a href={sub.href} class="block py-1 text-sm text-gray-600 hover:text-[#3e61ff]">
                {sub.name}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
    <div class="pt-4 border-t border-gray-100 flex flex-col space-y-2">
      <a
        href={`${base}/developers/docs`}
        class="text-center py-2.5 text-sm font-semibold text-[#0f1419] hover:bg-gray-50 rounded-lg"
      >
        Documentation
      </a>
      <a
        href={`${base}/company/contact`}
        class="btn-unibase-primary w-full text-center"
      >
        Get Started
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
